rules_version = '2';

// ============================================================
//  FIRESTORE RULES GABUNGAN — Allegro Global Construction
//
//  Satu Firebase project dipakai dua aplikasi:
//    1. ALLEGRO EMS      — absensi, payroll, HRIS   (Tahap 22: staf proyek mencatat absen tim seperti mandor, KTP dibaca HR/Owner, mandor tanpa cuti/izin/SP, izin pulang diketahui atasan, masuk hari libur + tanpaLembur)
//    2. ALLEGRO PROJECT  — admin proyek (Fase 1)    (blok ap* di bagian bawah)
//
//  Bagian EMS disalin apa adanya dari rules Tahap 22 (firestore.rules di repo allegro-ems).
//  Semua tambahan untuk aplikasi Admin Proyek diberi tanda komentar
//  "[ADMIN PROYEK]" supaya mudah ditelusuri dan dicabut bila perlu.
//
//  Prinsip: DEFAULT DENY. Semua yang tidak disebut di sini ditolak.
//  Menu yang disembunyikan di layar BUKAN keamanan. Aturan di file
//  inilah yang benar-benar menjaga data.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- fungsi bantu ----------
    function emailSuperAdmin() {
      return 'syam.rakhmany@gmail.com';
    }

    function sudahLogin() {
      return request.auth != null;
    }

    function emailUser() {
      return request.auth.token.email.lower();
    }

    /** Email yang dipakai sebagai dasar hak (super admin, undangan) wajib
        sudah terverifikasi. Login Google selalu terverifikasi; ini menutup
        jalan bila kelak provider lain (email/password) ikut dinyalakan. */
    /** Alamat foto / tanda tangan wajib berasal dari Cloudinary. Tanpa ini,
        field foto bisa diisi alamat apa saja (termasuk javascript:) lewat API. */
    function fotoCloudinary(u) {
      return u is string && u.matches('https://res[.]cloudinary[.]com/.+');
    }

    function emailTerverifikasi() {
      return request.auth.token.email_verified == true;
    }

    function profilSaya() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function berperan(peran) {
      return sudahLogin()
        && profilSaya().status == 'ACTIVE'
        && profilSaya().role == peran;
    }

    function isAdmin()   { return berperan('ADMIN'); }
    function isFinance() { return berperan('FINANCE'); }
    function isMandor()  { return berperan('MANDOR'); }
    function isHR()      { return berperan('HR'); }
    function isOwner()   { return berperan('OWNER'); }

    /** Yang mengurus kepegawaian: HR, Owner, dan Admin sistem. */
    function urusKepegawaian() {
      return isAdmin() || isHR() || isOwner();
    }

    /** Kode karyawan yang tersambung ke akun yang sedang login. */
    function karyawanSaya() {
      return profilSaya().employeeId;
    }

    /** Siapa saja yang sudah diberi peran dan masih aktif. */
    function pegawaiAktif() {
      return sudahLogin() && profilSaya().status == 'ACTIVE' && profilSaya().role != 'PENDING';
    }

    // ---------- [ADMIN PROYEK] fungsi bantu aplikasi admin proyek ----------
    // Peran aplikasi Admin Proyek disimpan di field TERPISAH: roleProyek.
    // Field role milik EMS tidak disentuh, jadi hak di EMS tetap utuh.

    function roleProyek() {
      return profilSaya().get('roleProyek', 'PENDING');
    }

    function berperanProyek(daftar) {
      return sudahLogin()
        && profilSaya().status == 'ACTIVE'
        && roleProyek() in daftar;
    }

    function superProyek() {
      return sudahLogin() && emailTerverifikasi() && emailUser() == emailSuperAdmin();
    }

    /** Semua orang DALAM yang sudah diberi peran di aplikasi Admin Proyek.
        Peran KLIEN sengaja TIDAK pernah masuk daftar ini. */
    function wargaProyek() {
      return superProyek() || berperanProyek([
        'SUPER_ADMIN', 'DIREKSI', 'HEAD_ADMIN', 'PURCHASING',
        'ADMIN_PROYEK', 'ADMIN_DATA', 'PLANNER', 'QS', 'KOORDINATOR', 'PIC',
        'STAF_LAPANGAN', 'LOGISTIK'
      ]);
    }

    // ---------- [ADMIN PROYEK] Fase 5 — klien ----------
    // KLIEN adalah orang luar. Ia TIDAK pernah masuk wargaProyek(); haknya
    // diberikan satu per satu, hanya baca, dan hanya untuk proyeknya sendiri.

    function klienAktif() {
      return sudahLogin()
        && profilSaya().status == 'ACTIVE'
        && roleProyek() == 'KLIEN';
    }

    /** Daftar kode proyek yang boleh dibuka klien ini. */
    function proyekKlienSaya() {
      return profilSaya().get('proyekKlien', []);
    }

    function klienPunya(kodeProyek) {
      return klienAktif() && kodeProyek in proyekKlienSaya();
    }

    /** Yang boleh menyetujui & mengesahkan di aplikasi Admin Proyek. */
    function atasanProyek() {
      return superProyek() || berperanProyek(['SUPER_ADMIN', 'DIREKSI', 'HEAD_ADMIN']);
    }

    // ---------- users ----------
    match /users/{uid} {

      allow read: if sudahLogin() && (request.auth.uid == uid || isAdmin());
      // [ADMIN PROYEK] Atasan aplikasi ini perlu melihat daftar akun untuk
      // memberi peran dan membuka akses klien.
      allow read: if atasanProyek();

      // Pendaftaran diri sendiri saat login Google pertama kali.
      // Semua orang masuk sebagai PENDING, kecuali super admin.
      allow create: if sudahLogin()
        && request.auth.uid == uid
        && request.resource.data.email == emailUser()
        && request.resource.data.projectIds.size() == 0
        && request.resource.data.sectionIds.size() == 0
        // [ADMIN PROYEK] Peran aplikasi Admin Proyek tidak boleh diisi sendiri
        // saat mendaftar. Tanpa dua baris ini, siapa pun bisa "menanam"
        // roleProyek tinggi yang hidup begitu akunnya diaktifkan.
        && request.resource.data.get('roleProyek', 'PENDING') == 'PENDING'
        && request.resource.data.get('proyekKlien', []).size() == 0
        // Sambungan karyawan menentukan data siapa yang boleh dibaca
        // (slip, absen, cuti), jadi tidak boleh diisi sendiri saat mendaftar.
        && (
          (emailUser() == emailSuperAdmin()
            && emailTerverifikasi()
            && request.resource.data.role == 'ADMIN'
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.get('employeeId', null) == null)
          ||
          (emailUser() != emailSuperAdmin()
            && request.resource.data.role == 'PENDING'
            && request.resource.data.status == 'PENDING'
            && request.resource.data.get('employeeId', null) == null)
          ||
          // Sudah diundang Admin: peran dan sambungan karyawannya harus
          // PERSIS sama dengan undangan, jadi tidak bisa diganti sendiri.
          (emailUser() != emailSuperAdmin()
            && emailTerverifikasi()
            && exists(/databases/$(database)/documents/undangan/$(emailUser()))
            && request.resource.data.role == get(/databases/$(database)/documents/undangan/$(emailUser())).data.role
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.get('employeeId', null)
                 == get(/databases/$(database)/documents/undangan/$(emailUser())).data.employeeId)
        );

      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && (resource.data.email != emailSuperAdmin() || emailUser() == emailSuperAdmin());

      // [ADMIN PROYEK] Atasan aplikasi ini boleh mengatur roleProyek dan
      // proyekKlien SAJA. Seluruh field milik EMS wajib sama persis, sehingga
      // hak di EMS tidak bisa dinaikkan lewat aplikasi ini.
      allow update: if atasanProyek()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['roleProyek', 'proyekKlien', 'status'])
        && resource.data.email != emailSuperAdmin()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        // Status boleh diaktifkan DARI SINI hanya untuk akun yang TIDAK punya
        // peran EMS (role masih PENDING) — misalnya akun klien. Dengan begitu
        // akun itu hidup di aplikasi Admin Proyek, tetapi di EMS tetap nol akses
        // karena semua fungsi EMS mensyaratkan role != 'PENDING'.
        && (request.resource.data.status == resource.data.status
            || (resource.data.role == 'PENDING'
                && request.resource.data.role == 'PENDING'
                && request.resource.data.status in ['ACTIVE', 'PENDING']))
        && request.resource.data.get('employeeId', null) == resource.data.get('employeeId', null)
        && request.resource.data.get('projectIds', []) == resource.data.get('projectIds', [])
        && request.resource.data.get('sectionIds', []) == resource.data.get('sectionIds', [])
        // Tidak boleh mengangkat diri sendiri, dan tidak boleh mencetak super admin baru.
        && request.auth.uid != uid
        && request.resource.data.get('roleProyek', 'PENDING') != 'SUPER_ADMIN';

      allow delete: if false;
    }

    // ---------- undangan ----------
    // Admin menyiapkan akun sebelum orangnya login: email, peran, dan
    // karyawan yang disambungkan. ID dokumen = email huruf kecil.
    // Dipakai sekali saat login pertama, lalu dihapus pemiliknya.
    match /undangan/{email} {
      allow read: if isAdmin() || (sudahLogin() && emailTerverifikasi() && email == emailUser());
      allow create: if isAdmin()
        && email == email.lower()
        && email != emailSuperAdmin()
        && request.resource.data.email == email
        && request.resource.data.role in ['ADMIN', 'HR', 'OWNER', 'FINANCE', 'MANDOR', 'KARYAWAN']
        && (request.resource.data.employeeId == null || request.resource.data.employeeId is string);
      allow update: if false;
      allow delete: if isAdmin() || (sudahLogin() && emailTerverifikasi() && email == emailUser());
    }

    // ---------- projects ----------
    function proyekSah() {
      let d = request.resource.data;
      return d.code is string && d.code.size() > 0
        && d.name is string && d.name.size() > 0
        && d.address is string
        && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
        && d.attendanceRadiusMeter is number
        && d.attendanceRadiusMeter >= 50 && d.attendanceRadiusMeter <= 5000
        && d.status in ['ACTIVE', 'COMPLETED', 'SUSPENDED', 'ARCHIVED'];
    }

    match /projects/{projectId} {
      // Mandor ikut boleh membaca: koordinat proyek dibutuhkan saat absensi.
      // [ADMIN PROYEK] wargaProyek() ditambahkan supaya staf admin proyek
      // yang belum punya peran EMS tetap bisa melihat daftar proyek.
      allow read: if pegawaiAktif() || wargaProyek();
      // [ADMIN PROYEK] Fase 5 — klien boleh membuka data proyeknya sendiri
      // satu per satu (get), bukan daftar seluruh proyek (list).
      allow get: if klienPunya(projectId);

      // Kode proyek = ID dokumen, jadi keunikannya dijamin Firestore.
      // [ADMIN PROYEK] master proyek dipegang aplikasi Admin Proyek, jadi
      // Head Admin / Direksi ikut boleh membuat & mengubahnya.
      allow create: if (isAdmin() || atasanProyek()) && proyekSah()
        && request.resource.data.code == projectId;

      // Kode tidak boleh berubah setelah dibuat.
      allow update: if (isAdmin() || atasanProyek()) && proyekSah()
        && request.resource.data.code == resource.data.code;

      // Proyek tidak dihapus, cukup diubah statusnya jadi ARCHIVED.
      allow delete: if false;
    }

    // ---------- sections ----------
    function sectionSah() {
      let d = request.resource.data;
      return d.projectId is string && d.projectId.size() > 0
        && d.code is string && d.code.size() > 0
        && d.name is string && d.name.size() > 0
        && d.status in ['ACTIVE', 'INACTIVE'];
    }

    match /sections/{sectionId} {
      allow read: if pegawaiAktif();
      allow create: if isAdmin() && sectionSah();
      allow update: if isAdmin() && sectionSah()
        && request.resource.data.code == resource.data.code
        && request.resource.data.projectId == resource.data.projectId;
      allow delete: if false;
    }

    // ---------- employees ----------
    function karyawanSah() {
      let d = request.resource.data;
      return d.employeeCode is string && d.employeeCode.size() > 0
        && d.name is string && d.name.size() > 0
        && d.nik is string && d.nik.size() == 16
        && d.position in ['MANDOR', 'TUKANG', 'KENEK', 'STAF', 'PIC']
        && d.status in ['ACTIVE', 'INACTIVE'];
    }

    /** Proyek penugasan berjalan dari karyawan yang sedang login; '' bila tidak ada. */
    function proyekPenugasanSaya() {
      return (karyawanSaya() is string
          && exists(/databases/$(database)/documents/employees/$(karyawanSaya())))
        ? get(/databases/$(database)/documents/employees/$(karyawanSaya())).data.get('currentProjectId', '')
        : '';
    }

    /** Staf yang ditugaskan ke proyek boleh melihat tim lapangan proyek itu (Tahap 22). */
    function punyaProyekPenugasan() {
      return sudahLogin()
        && proyekPenugasanSaya() is string
        && proyekPenugasanSaya().size() > 0;
    }

    /** Posisi seorang karyawan menurut dokumennya; dipakai menolak cuti/izin/SP untuk mandor. */
    function posisiKaryawan(id) {
      return get(/databases/$(database)/documents/employees/$(id)).data.position;
    }

    match /employees/{employeeId} {
      // Mandor hanya boleh membaca karyawan yang sedang ditugaskan
      // kepadanya. Kolom currentMandorId adalah cerminan penugasan yang
      // sedang berjalan; histori lengkapnya ada di employeeAssignments.
      allow read: if isAdmin()
        || isFinance()
        || isHR()
        || isOwner()
        // Setiap orang boleh membaca data karyawannya sendiri - itu yang
        // dipakai halaman Cuti Saya untuk tahu divisi dan tanggal masuk.
        || (sudahLogin() && employeeId == karyawanSaya())
        // Atasan langsung boleh membaca data bawahannya.
        || (sudahLogin()
            && resource != null
            && resource.data.atasanId == karyawanSaya())
        || (isMandor()
            && resource != null
            && resource.data.currentMandorId == profilSaya().employeeId)
        // Staf kantor yang ditugaskan ke proyek melihat pekerja lapangan di
        // proyek yang sama (halaman Tim lapangan, 10 Okt 2026). Posisi staf
        // di atas mandor, jadi ia boleh melihat semua tim di proyeknya.
        || (punyaProyekPenugasan()
            && resource != null
            && resource.data.currentProjectId == proyekPenugasanSaya())
        // [ADMIN PROYEK] nama tukang & mandor dibutuhkan untuk rekap gaji,
        // klaim, dan pengajuan transfer. Hanya membaca, tidak menulis.
        || atasanProyek()
        || berperanProyek(['ADMIN_PROYEK']);

      allow create: if isAdmin() && karyawanSah()
        && request.resource.data.employeeCode == employeeId;

      allow update: if (isAdmin() || isHR()) && karyawanSah()
        && request.resource.data.employeeCode == resource.data.employeeCode
        && request.resource.data.nik == resource.data.nik;

      // Karyawan boleh memperbarui data pribadinya sendiri, tetapi HANYA
      // kolom di bawah ini. Nama, NIK, jabatan, divisi, jadwal, dan tarif
      // tetap wilayah Admin.
      //
      // Rekening (bank, nomor, atas nama) boleh diisi sendiri sejak
      // 9 Okt 2026 (keputusan client). Risikonya: akun Google yang dibajak
      // bisa memindahkan rekening. Pagarnya: setiap perubahan rekening wajib
      // menulis penanda waktu rekeningDiubahSendiriPada = jam server, supaya
      // HR melihat bahwa itu bukan isian kantor, dan ketiganya harus lengkap.
      allow update: if sudahLogin()
        && employeeId == karyawanSaya()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nickname', 'phone', 'address',
                       'profilePhotoUrl', 'profilePublicId',
                       'bankName', 'bankAccountNumber', 'bankAccountName',
                       'rekeningDiubahSendiriPada', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['bankName', 'bankAccountNumber', 'bankAccountName'])
          || (
            request.resource.data.rekeningDiubahSendiriPada == request.time
            && request.resource.data.bankName is string
            && request.resource.data.bankAccountNumber is string
            && request.resource.data.bankAccountName is string
            && (
              (request.resource.data.bankName.size() == 0
                && request.resource.data.bankAccountNumber.size() == 0
                && request.resource.data.bankAccountName.size() == 0)
              ||
              (request.resource.data.bankName.size() > 0
                && request.resource.data.bankAccountNumber.size() > 0
                && request.resource.data.bankAccountName.size() > 0)
            )
          )
        );

      // Hanya boleh dihapus kalau memang salah input dan belum dipakai
      // di mana pun. Setelah ada absensi, karyawan cukup dinonaktifkan.
      allow delete: if isAdmin();
    }

    // ---------- employeePrivate (foto KTP) ----------
    // Sengaja dipisah dari employees supaya Finance dan Mandor tidak
    // ikut membacanya. KTP adalah identitas resmi, bukan data operasional.
    // HR dan Owner boleh membaca sejak Tahap 22: foto KTP ditampilkan di
    // rincian absen untuk mencocokkan wajah sebelum memvalidasi.
    match /employeePrivate/{employeeId} {
      allow read: if urusKepegawaian();
      allow write: if isAdmin();
    }

    // ---------- salaryRates ----------
    function tarifSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.paymentMode in ['DAILY', 'HOURLY']
        && d.dailyRate is number && d.dailyRate >= 0
        && d.hourlyRate is number && d.hourlyRate >= 0
        && d.overtimeHourlyRate is number && d.overtimeHourlyRate >= 0
        && d.effectiveFrom is string && d.effectiveFrom.size() == 10;
    }

    match /salaryRates/{rateId} {
      // Mandor tidak boleh melihat gaji siapa pun, termasuk gajinya sendiri
      // lewat jalur ini. Itu urusan Admin dan Finance.
      allow read: if isAdmin() || isFinance();

      allow create: if isAdmin() && tarifSah() && request.resource.data.effectiveUntil == null;

      // Satu-satunya perubahan yang diizinkan: menutup masa berlaku.
      // Angkanya sendiri tidak boleh diubah, karena payroll lama memakainya.
      allow update: if isAdmin()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.paymentMode == resource.data.paymentMode
        && request.resource.data.dailyRate == resource.data.dailyRate
        && request.resource.data.hourlyRate == resource.data.hourlyRate
        && request.resource.data.overtimeHourlyRate == resource.data.overtimeHourlyRate
        && request.resource.data.effectiveFrom == resource.data.effectiveFrom;

      allow delete: if false;
    }

    // ---------- employeeAssignments ----------
    function penugasanSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.projectId is string && d.projectId.size() > 0
        && d.sectionId is string && d.sectionId.size() > 0
        && d.mandorId is string && d.mandorId.size() > 0
        // Penanggung jawab tidak boleh diri sendiri, KECUALI orang itu
        // memang seorang mandor. Mandor mengabsen dirinya sendiri, dan
        // kolom inilah yang dipakai untuk menentukan hak bacanya.
        && (
          d.mandorId != d.employeeId
          || get(/databases/$(database)/documents/employees/$(d.employeeId)).data.position == 'MANDOR'
        )
        && d.effectiveFrom is string && d.effectiveFrom.size() == 10
        && d.status in ['ACTIVE', 'ENDED'];
    }

    match /employeeAssignments/{assignmentId} {
      allow read: if isAdmin()
        || isFinance()
        || (isMandor()
            && resource != null
            && resource.data.mandorId == profilSaya().employeeId);

      allow create: if isAdmin() && penugasanSah()
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.effectiveUntil == null;

      // Hanya untuk menutup penugasan. Isi penugasannya tidak boleh diubah,
      // supaya histori penempatan tetap sesuai kenyataan.
      allow update: if isAdmin()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.sectionId == resource.data.sectionId
        && request.resource.data.mandorId == resource.data.mandorId
        && request.resource.data.effectiveFrom == resource.data.effectiveFrom;

      allow delete: if false;
    }

    // ---------- jam server untuk absen (9 Okt 2026) ----------
    // Jam HP/laptop bisa disetel bebas: pernah absen masuk jam 9, jam laptop
    // dimundurkan ke jam 5, lalu absen pulang diterima dengan jam 5. Maka:
    //   1. Klien mengambil jam server lewat dokumen jamServer/{uid}: menulis
    //      serverTimestamp lalu membacanya kembali (lib/jam-server.ts).
    //   2. Setiap sesi absen yang BARU ditulis wajib ber-recordedAt jam server
    //      (serverTimestamp == request.time), kolom waktu-nya tidak jauh dari
    //      jam server, dan tanggal dokumennya adalah hari ini menurut WIB.
    //   3. Sesi yang sudah tersimpan tidak boleh diubah lewat jalur karyawan
    //      atau mandor; koreksi hanya lewat Admin yang berjejak.
    match /jamServer/{uid} {
      allow read: if sudahLogin() && request.auth.uid == uid;
      allow create, update: if sudahLogin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pada'])
        && request.resource.data.pada == request.time;
      allow delete: if false;
    }

    /** Jam server digeser ke WIB (UTC+7), untuk membaca tanggal hari ini. */
    function jamServerWIB() {
      return request.time + duration.value(7, 'h');
    }

    /** "09" -> 9. Nol di depan dibuang dulu supaya int() tidak salah tafsir. */
    function angkaDuaDigit(s) {
      return int(s.replace('^0', ''));
    }

    /** Tanggal "YYYY-MM-DD" ini adalah hari ini menurut WIB. */
    function tanggalHariIniWIB(tanggal) {
      let t = jamServerWIB();
      return tanggal is string && tanggal.size() == 10
        && int(tanggal[0:4]) == t.year()
        && angkaDuaDigit(tanggal[5:7]) == t.month()
        && angkaDuaDigit(tanggal[8:10]) == t.day();
    }

    /**
     * Teks ISO UTC "YYYY-MM-DDTHH:MM:SS.sssZ" tidak lebih dari 5 menit dari
     * jam server. Toleransinya untuk jeda antara pengambilan jam server dan
     * tiba-nya tulisan ini, bukan untuk jam perangkat. Tepat di pergantian
     * hari UTC (07.00 WIB) kedua jam bisa jatuh di tanggal berbeda, dan itu
     * ditangani di gantiHari.
     */
    function waktuDekatJamServer(w) {
      let t = request.time;
      let hariSama = int(w[0:4]) == t.year()
        && angkaDuaDigit(w[5:7]) == t.month()
        && angkaDuaDigit(w[8:10]) == t.day();
      let m = angkaDuaDigit(w[11:13]) * 60 + angkaDuaDigit(w[14:16]);
      let mt = t.hours() * 60 + t.minutes();
      let gantiHari = (m >= 1435 && mt <= 4) || (mt >= 1435 && m <= 4);
      return w is string && w.size() >= 16
        && ((hariSama && m - mt <= 5 && mt - m <= 5) || gantiHari);
    }

    /** Satu sesi absen yang baru dicatat: jam server, bukan jam perangkat. */
    function sesiBerjamServer(s) {
      return s is map
        && s.recordedAt == request.time
        && s.waktu is string
        && waktuDekatJamServer(s.waktu);
    }

    /** Saat dokumen dibuat: tiap sesi kosong, atau berjam server. */
    function sesiKosongAtauBerjamServer(k) {
      let d = request.resource.data;
      return d.get(k, null) == null || sesiBerjamServer(d[k]);
    }

    /** Saat dokumen diubah: sesi yang sudah ada tidak disentuh; sesi baru berjam server. */
    function sesiTetapAtauBaru(k) {
      let lama = resource.data.get(k, null);
      let baru = request.resource.data.get(k, null);
      return (lama != null && baru == lama)
        || (lama == null && (baru == null || sesiBerjamServer(baru)));
    }

    // ---------- attendance ----------
    function radiusProyek(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.attendanceRadiusMeter;
    }

    function absensiSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.date is string && d.date.size() == 10
        && d.projectId is string && d.projectId.size() > 0
        && d.mandorId is string && d.mandorId.size() > 0
        && d.workHours is number && d.workHours >= 0
        && d.overtimeHours is number && d.overtimeHours >= 0
        && d.status in ['BELUM', 'HADIR', 'TIDAK_LENGKAP', 'SELESAI'];
    }

    /** Jarak sesi yang baru ditulis harus di dalam radius proyek. */
    function jarakWajar() {
      let t = request.resource.data.terakhir;
      return t == null
        || (t.jarakMeter is number
            && t.jarakMeter >= 0
            && t.jarakMeter <= radiusProyek(request.resource.data.projectId));
    }

    /**
     * Pekerja lapangan (tukang/kenek) yang punya akun boleh mengabsen
     * dirinya sendiri (9 Okt 2026), tetapi hanya di proyek dan di bawah
     * mandor yang sedang ditugaskan kepadanya menurut dokumen karyawannya.
     * Dengan begitu catatannya tetap muncul di tim mandor yang benar.
     */
    function absenDiriSendiri() {
      let d = request.resource.data;
      let k = get(/databases/$(database)/documents/employees/$(d.employeeId)).data;
      return sudahLogin()
        && d.employeeId == karyawanSaya()
        // Dibaca dengan nilai bawaan null supaya karyawan yang belum
        // ditugaskan ditolak dengan rapi, bukan lewat galat kolom hilang.
        && d.mandorId == k.get('currentMandorId', null)
        && d.projectId == k.get('currentProjectId', null);
    }

    /**
     * Staf kantor (bukan posisi lapangan) yang ditugaskan ke proyek boleh
     * mencatat absen pekerja lapangan di proyek itu, sama seperti mandor
     * (keputusan client 10 Okt 2026). Mandor biasanya vendor; staf proyek
     * adalah orang kantor yang mengawasi di lokasi, posisinya di atas mandor.
     */
    function stafKantorProyek() {
      return punyaProyekPenugasan()
        && !(posisiKaryawan(karyawanSaya()) in ['MANDOR', 'TUKANG', 'KENEK']);
    }

    /**
     * Catatan yang ditulis staf proyek: proyeknya harus proyek penugasan si
     * staf, dan mandorId tetap mandor si pekerja — supaya tim mandor dan
     * pengelompokan payroll tidak bergeser ke staf.
     */
    function stafProyekMencatat() {
      let d = request.resource.data;
      return stafKantorProyek()
        && d.projectId == proyekPenugasanSaya()
        && d.mandorId == get(/databases/$(database)/documents/employees/$(d.employeeId)).data.get('currentMandorId', null);
    }

    /** Dokumen absensi lapangan baru: hari ini, semua sesinya berjam server. */
    function sesiLapanganBaruSah() {
      return tanggalHariIniWIB(request.resource.data.date)
        && sesiKosongAtauBerjamServer('checkIn')
        && sesiKosongAtauBerjamServer('breakStart')
        && sesiKosongAtauBerjamServer('breakEnd')
        && sesiKosongAtauBerjamServer('checkOut')
        && sesiKosongAtauBerjamServer('overtimeStart')
        && sesiKosongAtauBerjamServer('overtimeEnd');
    }

    /** Ubahan absensi lapangan: sesi lama utuh, sesi baru berjam server. */
    function sesiLapanganTetapAtauBaru() {
      return sesiTetapAtauBaru('checkIn')
        && sesiTetapAtauBaru('breakStart')
        && sesiTetapAtauBaru('breakEnd')
        && sesiTetapAtauBaru('checkOut')
        && sesiTetapAtauBaru('overtimeStart')
        && sesiTetapAtauBaru('overtimeEnd');
    }

    match /attendance/{absenId} {
      // Catatan: "resource == null" berarti dokumennya belum ada. Itu
      // keadaan normal saat absen pertama hari itu diperiksa lebih dulu,
      // dan harus dijawab "boleh" — bukan dibiarkan jadi galat, karena
      // galat di dalam rules ikut terbaca sebagai penolakan izin.
      allow read: if isAdmin()
        || isFinance()
        || urusKepegawaian()
        // Setiap orang boleh melihat catatan absensinya sendiri.
        || (sudahLogin()
            && (resource == null || resource.data.employeeId == karyawanSaya()))
        || (isMandor()
            && (resource == null || resource.data.mandorId == profilSaya().employeeId))
        // Staf yang ditugaskan ke proyek melihat absensi lapangan proyek itu
        // (halaman Tim lapangan, 10 Okt 2026).
        || (punyaProyekPenugasan()
            && resource != null
            && resource.data.projectId == proyekPenugasanSaya());

      // ID dokumen wajib "<employeeId>_<tanggal>". Inilah yang membuat
      // satu orang mustahil punya dua catatan di hari yang sama, termasuk
      // ketika sinyal putus lalu aplikasi mengirim ulang.
      allow create: if absensiSah()
        && jarakWajar()
        && absenId == request.resource.data.employeeId + '_' + request.resource.data.date
        && (
          isAdmin()
          || (
            // Mandor dan pekerja sendiri hanya bisa mencatat hari ini dengan
            // jam server. Admin dikecualikan karena memasukkan catatan lama.
            sesiLapanganBaruSah()
            && (
              (isMandor() && request.resource.data.mandorId == profilSaya().employeeId)
              || absenDiriSendiri()
              // Staf proyek mencatat untuk pekerja di proyeknya (10 Okt 2026).
              || stafProyekMencatat()
            )
          )
        );

      // Mandor hanya boleh menambah sesi pada catatan miliknya sendiri,
      // dan tidak boleh memindahkan catatan itu ke orang atau hari lain.
      // Pekerja lapangan boleh menambah sesi pada catatannya sendiri.
      allow update: if absensiSah()
        && jarakWajar()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.date == resource.data.date
        && request.resource.data.mandorId == resource.data.mandorId
        && (
          isAdmin()
          || (
            // Setelah Admin mengoreksi, mandor maupun pemiliknya tidak bisa
            // menulis lagi pada catatan itu. Kalau masih ada yang keliru,
            // jalurnya lewat Admin, supaya tetap berjejak.
            resource.data.isOverridden == false
            // Hanya hari ini, hanya menambah sesi, dan sesi barunya berjam server.
            && tanggalHariIniWIB(resource.data.date)
            && sesiLapanganTetapAtauBaru()
            && (
              (isMandor() && resource.data.mandorId == profilSaya().employeeId)
              || (sudahLogin() && resource.data.employeeId == karyawanSaya())
              // Staf proyek menambah sesi pada catatan di proyeknya; mandorId
              // sudah dijaga tidak berubah oleh syarat di atas.
              || (stafKantorProyek() && resource.data.projectId == proyekPenugasanSaya())
            )
          )
        );

      // Absensi tidak dihapus. Kalau salah, jalurnya koreksi ber-audit.
      allow delete: if false;
    }

    // ---------- attendanceCorrections (jejak audit) ----------
    /** Tanda tangan yang digoreskan saat itu: tautan gambar + nama penanda. */
    function tandaTanganSah(d) {
      return d.tandaTangan is map
        && d.tandaTangan.url is string && d.tandaTangan.url.size() > 0
        && d.tandaTangan.nama is string && d.tandaTangan.nama.size() > 0
        && d.tandaTangan.email is string;
    }

    function koreksiSah() {
      let d = request.resource.data;
      return d.attendanceId is string && d.attendanceId.size() > 0
        && d.employeeId is string && d.employeeId.size() > 0
        && d.date is string && d.date.size() == 10
        && d.field in ['checkIn', 'breakStart', 'breakEnd', 'checkOut',
                       'overtimeStart', 'overtimeEnd']
        && d.hasil in ['VALID', 'TIDAK_VALID']
        && d.approvedBy is string && d.approvedBy.size() > 0
        // Setiap revisi absen wajib bertanda tangan Admin (9 Okt 2026).
        && tandaTanganSah(d)
        // Penilaian "tidak valid" tidak boleh sekadar diklik: wajib
        // menyebut alasannya dan melampirkan bukti. Ini ditegakkan di
        // server, bukan hanya di formulir, supaya tidak bisa dilewati.
        && (
          d.hasil == 'VALID'
          || (d.alasan is string && d.alasan.size() > 0
              && d.attachmentUrl is string && d.attachmentUrl.size() > 0)
        );
    }

    match /attendanceCorrections/{koreksiId} {
      allow read: if isAdmin() || isFinance();
      allow create: if isAdmin() && koreksiSah();

      // Jejak audit bersifat tambah-saja. Sekali tertulis, tidak bisa
      // diubah maupun dihapus oleh siapa pun, termasuk Admin.
      allow update, delete: if false;
    }

    // ---------- officeAttendanceCorrections (jejak revisi absen kantor) ----------
    // Koreksi jam dan keputusan absen luar radius oleh Admin/HR/Owner.
    // Tambah-saja dan wajib bertanda tangan, sama seperti attendanceCorrections.
    match /officeAttendanceCorrections/{koreksiId} {
      allow read: if urusKepegawaian() || isFinance();
      allow create: if urusKepegawaian()
        && request.resource.data.attendanceId is string
        && request.resource.data.attendanceId.size() > 0
        && request.resource.data.employeeId is string
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.jenis in ['KOREKSI_JAM', 'KEPUTUSAN_LUAR_RADIUS']
        && request.resource.data.approvedBy is string
        && request.resource.data.approvedBy.size() > 0
        && tandaTanganSah(request.resource.data);
      allow update, delete: if false;
    }

    // ---------- bon karyawan ----------
    function bonSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.employeeName is string && d.employeeName.size() > 0
        && d.originalAmount is number && d.originalAmount > 0
        && d.remainingAmount is number
        && d.remainingAmount >= 0
        && d.remainingAmount <= d.originalAmount
        && d.loanDate is string && d.loanDate.size() == 10
        && d.status in ['OPEN', 'PARTIALLY_PAID', 'PAID', 'CANCELLED'];
    }

    function rencanaCicilanSah(d) {
      return d.tenorBulan is number && d.tenorBulan >= 1
        && d.cicilanPerBulan is number && d.cicilanPerBulan > 0;
    }

    // Bon yang dibuat sebelum kasbon bisa dicicil tidak punya tenorBulan
    // dan cicilanPerBulan. Membandingkan kolom yang tidak ada menghasilkan
    // galat, bukan "salah", sehingga bon lama tidak bisa dibayar maupun
    // dibatalkan. Bon lama boleh diperbarui selama tetap tanpa rencana;
    // rencana tidak bisa disusulkan lewat update.
    function rencanaCicilanTetap() {
      let lama = resource.data;
      let baru = request.resource.data;
      return (
          !('tenorBulan' in lama) && !('tenorBulan' in baru)
          && !('cicilanPerBulan' in lama) && !('cicilanPerBulan' in baru)
        ) || (
          'tenorBulan' in lama && 'cicilanPerBulan' in lama
          && rencanaCicilanSah(baru)
          && baru.tenorBulan == lama.tenorBulan
          && baru.cicilanPerBulan == lama.cicilanPerBulan
        );
    }

    match /employeeLoans/{bonId} {
      // Karyawan tidak punya akses; bon adalah urusan Admin dan Finance.
      // HR ikut membaca karena menyusun payroll bulanan (usulan potongan bon).
      allow read: if isAdmin() || isFinance() || isOwner() || isHR();
      allow create: if (isAdmin() || isFinance()) && bonSah()
        && rencanaCicilanSah(request.resource.data);

      // Nominal asli dan pemiliknya tidak boleh berubah. Yang boleh
      // berubah hanya sisa dan statusnya, karena itulah yang bergerak
      // setiap kali ada pembayaran.
      // Owner ikut, karena potongan bon payroll bulanan dibukukan saat
      // Owner menyetujui payroll itu.
      allow update: if (isAdmin() || isFinance() || isOwner()) && bonSah()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.originalAmount == resource.data.originalAmount
        && request.resource.data.loanDate == resource.data.loanDate
        // Rencana cicilannya juga beku. Kalau perlu diubah, bonnya
        // dibatalkan lalu dibuat baru - supaya jejaknya jelas.
        && rencanaCicilanTetap();

      // Bon tidak dihapus. Yang salah dibatalkan, jejaknya tetap ada.
      allow delete: if false;
    }

    // ---------- loanLocks (penjaga satu bon aktif) ----------
    // ID dokumennya adalah kode karyawan. Karena Firestore menolak
    // "create" pada dokumen yang sudah ada, bon aktif kedua mustahil
    // terbentuk - bahkan bila dua orang menyimpan pada detik yang sama.
    match /loanLocks/{employeeId} {
      allow read: if isAdmin() || isFinance();
      allow create: if (isAdmin() || isFinance())
        && request.resource.data.employeeId == employeeId;
      allow update: if false;
      // Dihapus saat bon lunas atau dibatalkan, supaya karyawan itu
      // boleh mengajukan bon berikutnya.
      allow delete: if isAdmin() || isFinance() || isOwner();
    }

    // ---------- loanRepayments ----------
    match /loanRepayments/{bayarId} {
      // Owner dan HR ikut membaca untuk bagian "Data Kasbon" di slip gaji.
      allow read: if isAdmin() || isFinance() || isOwner() || isHR();
      allow create: if (isAdmin() || isFinance() || isOwner())
        && request.resource.data.loanId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      // Catatan pembayaran bersifat tambah-saja, sama seperti jejak audit.
      allow update, delete: if false;
    }

    // ---------- payroll ----------
    function statusPayroll(payrollId) {
      return get(/databases/$(database)/documents/payroll/$(payrollId)).data.status;
    }

    function payrollSah() {
      let d = request.resource.data;
      return d.projectId is string && d.projectId.size() > 0
        && d.sectionId is string && d.sectionId.size() > 0
        && d.periodStart is string && d.periodStart.size() == 10
        && d.periodEnd is string && d.periodEnd.size() == 10
        && d.periodEnd > d.periodStart
        && d.status in ['DRAFT', 'REVIEW', 'APPROVED', 'PAID', 'LOCKED']
        && d.totalNetPay is number;
    }

    match /payroll/{payrollId} {
      // [ADMIN PROYEK] Head Admin, Direksi, Admin Proyek, dan Admin Data
      // ikut MEMBACA: rekap upah mingguan inilah yang masuk ke antrean
      // Pengajuan Transfer. Menulis tetap hanya Admin/Finance EMS.
      allow read: if isAdmin() || isFinance() || isOwner()
        || atasanProyek() || berperanProyek(['ADMIN_PROYEK', 'ADMIN_DATA']);

      // ID dokumen mengunci satu periode per section, sehingga periode
      // yang sama tidak bisa dihitung dua kali.
      allow create: if (isAdmin() || isFinance())
        && payrollSah()
        && request.resource.data.status == 'DRAFT'
        && payrollId == request.resource.data.projectId + '__'
                      + request.resource.data.sectionId + '__'
                      + request.resource.data.periodStart;

      // Periode, proyek, dan section tidak boleh bergeser setelah dibuat.
      // Payroll yang sudah LOCKED tidak bisa disentuh siapa pun.
      allow update: if (isAdmin() || isFinance())
        && payrollSah()
        && resource.data.status != 'LOCKED'
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.sectionId == resource.data.sectionId
        && request.resource.data.periodStart == resource.data.periodStart
        && request.resource.data.periodEnd == resource.data.periodEnd;

      // Boleh dihapus hanya selagi DRAFT, untuk membatalkan salah hitung.
      // Sesudah disahkan, payroll adalah catatan pembayaran upah -
      // menghapusnya berarti menghapus bukti, jadi tidak diizinkan
      // walaupun oleh Admin.
      allow delete: if (isAdmin() || isFinance()) && resource.data.status == 'DRAFT';
    }

    // ---------- payrollItems ----------
    match /payrollItems/{itemId} {
      // [ADMIN PROYEK] ikut membaca, sama alasannya dengan payroll.
      allow read: if isAdmin() || isFinance() || isOwner()
        || atasanProyek() || berperanProyek(['ADMIN_PROYEK', 'ADMIN_DATA']);

      allow create: if (isAdmin() || isFinance())
        && request.resource.data.payrollId is string
        && request.resource.data.employeeId is string
        && request.resource.data.netPay is number;

      // Hanya boleh disesuaikan selagi DRAFT atau REVIEW, dan hanya
      // bagian tambahan/potongannya. Jam kerja dan tarif adalah salinan
      // dari absensi serta tarif yang berlaku saat itu - kalau keduanya
      // bisa diketik ulang, seluruh gunanya snapshot hilang.
      allow update: if (isAdmin() || isFinance())
        && statusPayroll(resource.data.payrollId) in ['DRAFT', 'REVIEW']
        && request.resource.data.payrollId == resource.data.payrollId
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.totalWorkDays == resource.data.totalWorkDays
        && request.resource.data.totalWorkHours == resource.data.totalWorkHours
        && request.resource.data.totalOvertimeHours == resource.data.totalOvertimeHours
        && request.resource.data.dailyRate == resource.data.dailyRate
        && request.resource.data.hourlyRate == resource.data.hourlyRate
        && request.resource.data.overtimeHourlyRate == resource.data.overtimeHourlyRate
        && request.resource.data.regularPay == resource.data.regularPay
        && request.resource.data.overtimePay == resource.data.overtimePay;

      allow delete: if (isAdmin() || isFinance())
        && statusPayroll(resource.data.payrollId) == 'DRAFT';
    }

    // ================= PAYROLL BULANAN (staf kantor) =================
    // Owner (Ko Freddy, Ko David, Pak Christian), HR (Firda), Finance
    // (merangkap, keputusan client 28 Sep 2026), dan Admin sistem.
    // Menyetujui, menandai dibayar, dan mengunci tetap hanya Owner.
    function urusGajiBulanan() {
      return isAdmin() || isHR() || isOwner() || isFinance();
    }

    // ---------- gajiBulanan ----------
    // Sama seperti salaryRates: angka tidak pernah diubah. Gaji lama
    // ditutup masa berlakunya, gaji baru dibuat.
    match /gajiBulanan/{gajiId} {
      allow read: if urusGajiBulanan();
      allow create: if urusGajiBulanan()
        && request.resource.data.employeeId is string
        && request.resource.data.gajiPokok is number
        && request.resource.data.gajiPokok > 0
        && request.resource.data.berlakuMulai is string
        && request.resource.data.berlakuMulai.size() == 7
        && request.resource.data.berlakuSampai == null
        && (!('tunjangan' in request.resource.data) || request.resource.data.tunjangan is map);
      allow update: if urusGajiBulanan()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['berlakuSampai'])
        && request.resource.data.berlakuSampai is string
        && request.resource.data.berlakuSampai.size() == 7;
      allow delete: if false;
    }

    // ---------- jenisTunjangan ----------
    // Daftar tunjangan diatur di aplikasi, bukan di kode. Tidak dihapus,
    // cukup dinonaktifkan, supaya payroll lama tetap terbaca.
    match /jenisTunjangan/{jenisId} {
      allow read: if urusGajiBulanan();
      allow create, update: if urusGajiBulanan()
        && request.resource.data.nama is string && request.resource.data.nama.size() > 0
        && request.resource.data.satuan in ['BULAN', 'HARI']
        && request.resource.data.urutan is number
        && request.resource.data.aktif is bool;
      allow delete: if false;
    }

    // ---------- payrollBulanan ----------
    function statusBulanan(bulan) {
      return get(/databases/$(database)/documents/payrollBulanan/$(bulan)).data.status;
    }

    // Dipakai saat induk dan barisnya dibuat dalam satu batch: get() masih
    // melihat keadaan sebelum batch (induknya belum ada), getAfter() yang
    // melihat hasilnya.
    function statusBulananSesudah(bulan) {
      return getAfter(/databases/$(database)/documents/payrollBulanan/$(bulan)).data.status;
    }

    match /payrollBulanan/{bulan} {
      allow read: if urusGajiBulanan();

      // ID dokumen = bulan, jadi satu bulan tidak bisa dihitung dua kali.
      allow create: if urusGajiBulanan()
        && request.resource.data.bulan == bulan
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.bonDiproses == false;

      allow update: if urusGajiBulanan()
        && resource.data.status != 'LOCKED'
        && request.resource.data.bulan == resource.data.bulan
        && request.resource.data.status in ['DRAFT', 'REVIEW', 'APPROVED', 'PAID', 'LOCKED']
        // Menyetujui (dan semua langkah sesudahnya) hanya oleh Owner.
        && (request.resource.data.status in ['DRAFT', 'REVIEW'] || isOwner() || resource.data.status == request.resource.data.status)
        // Yang sudah disetujui tidak bisa mundur.
        && !(resource.data.status in ['APPROVED', 'PAID'] && request.resource.data.status in ['DRAFT', 'REVIEW']);

      allow delete: if urusGajiBulanan() && resource.data.status == 'DRAFT';
    }

    // ---------- payrollBulananItems ----------
    match /payrollBulananItems/{itemId} {
      allow read: if urusGajiBulanan();

      allow create: if urusGajiBulanan()
        && statusBulananSesudah(request.resource.data.payrollId) == 'DRAFT'
        && itemId == request.resource.data.payrollId + '__' + request.resource.data.employeeId
        && request.resource.data.gajiPokok is number
        && request.resource.data.bersih is number;

      // Hanya isian manual dan hasil hitungnya yang boleh berubah, dan
      // hasil hitungnya diperiksa di sini juga - jadi angka diterima tidak
      // bisa diketik bebas. Uang kerajinan hanya boleh diubah Owner.
      allow update: if urusGajiBulanan()
        && statusBulanan(resource.data.payrollId) in ['DRAFT', 'REVIEW']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'bonus', 'lembur', 'lemburKet', 'potonganAlpa', 'uangKerajinan', 'tambahanLain',
             'tambahanLainKet', 'potonganLain', 'potonganLainKet', 'potonganBon',
             'potonganBpjs', 'catatan', 'kotor', 'totalPotongan', 'bersih', 'updatedAt'])
        && (request.resource.data.uangKerajinan == resource.data.uangKerajinan || isOwner())
        && request.resource.data.potonganBon <= resource.data.sisaBon
        // Tunjangan tetap adalah salinan (tidak bisa diubah); bonus diisi manual.
        && request.resource.data.kotor == resource.data.gajiPokok
             + resource.data.get('totalTunjangan', 0) + request.resource.data.get('bonus', 0)
             + request.resource.data.lembur
             + request.resource.data.uangKerajinan + request.resource.data.tambahanLain
        && request.resource.data.totalPotongan == resource.data.dendaTelat + request.resource.data.potonganAlpa
             + request.resource.data.potonganBon + request.resource.data.potonganLain
             + request.resource.data.get('potonganBpjs', 0)
        && request.resource.data.bersih == request.resource.data.kotor - request.resource.data.totalPotongan;

      allow delete: if urusGajiBulanan() && statusBulanan(resource.data.payrollId) == 'DRAFT';
    }

    // ---------- slipGaji ----------
    // Slip yang sudah terbit ke karyawan. Dibuat Owner saat payroll
    // ditandai Dibayar (atau sesudahnya), lalu tidak pernah diubah atau
    // dihapus. Karyawan hanya bisa membaca slip miliknya sendiri.
    match /slipGaji/{slipId} {
      allow read: if urusGajiBulanan()
        || isFinance()
        || (sudahLogin() && resource.data.employeeId == karyawanSaya());

      allow create: if isOwner()
        && slipId == request.resource.data.bulan + '__' + request.resource.data.employeeId
        && statusBulananSesudah(request.resource.data.bulan) in ['PAID', 'LOCKED']
        && request.resource.data.bersih is number;

      allow update, delete: if false;
    }

    // ---------- hari libur ----------
    // Tanggal dipakai sebagai ID dokumen, jadi satu tanggal tidak bisa
    // terdaftar dua kali.
    match /holidays/{tanggal} {
      allow read: if pegawaiAktif();
      allow create: if urusKepegawaian()
        && request.resource.data.tanggal == tanggal
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.jenis in ['NASIONAL', 'CUTI_BERSAMA', 'PERUSAHAAN'];
      allow update, delete: if urusKepegawaian();
    }

    // ---------- saldo cuti ----------
    function saldoSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.tahun is number
        && d.jatahTahunan is number && d.jatahTahunan >= 0
        && d.penyesuaian is number
        && d.tahunanTerpakai is number && d.tahunanTerpakai >= 0
        && d.jatahSakit is number && d.jatahSakit >= 0
        && d.sakitTerpakai is number && d.sakitTerpakai >= 0;
    }

    match /leaveBalances/{saldoId} {
      // Karyawan hanya boleh melihat saldonya sendiri. Finance membaca
      // untuk sisa cuti di slip gaji.
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin()
            && (resource == null || resource.data.employeeId == karyawanSaya()));

      // Saldo tidak boleh diubah oleh pemiliknya sendiri, hanya oleh HR.
      allow create, update: if urusKepegawaian() && saldoSah()
        // Bagian sebelum garis bawah wajib kode karyawannya, supaya satu
        // orang tidak bisa punya dua kartu di tahun yang sama.
        && saldoId.split('_')[0] == request.resource.data.employeeId;
      allow delete: if false;
    }

    // ---------- pengajuan cuti & izin ----------
    function pengajuanSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.jenis is string && d.jenis.size() > 0
        && d.tanggalMulai is string && d.tanggalMulai.size() == 10
        && d.tanggalSelesai is string && d.tanggalSelesai.size() == 10
        && d.tanggalSelesai >= d.tanggalMulai
        && d.jumlahHari is number && d.jumlahHari >= 0
        && d.alasan is string && d.alasan.size() > 0
        && d.status in ['DIAJUKAN', 'DISETUJUI', 'DITOLAK', 'DIBATALKAN'];
    }

    // ---------- izinKeluar (izin meninggalkan kantor saat jam kerja) ----------
    // Dibuat karyawan, diketahui HR, disetujui Owner. Jam keluar dan kembali
    // dicatat karyawan sendiri (swafoto + GPS) dan tidak bisa ditimpa.
    match /izinKeluar/{izinId} {
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin() && resource.data.employeeId == karyawanSaya())
        || (sudahLogin() && resource.data.atasanId == karyawanSaya());

      allow create: if sudahLogin()
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId == karyawanSaya()
        // Mandor adalah pihak ketiga: tidak ada izin (client, 10 Okt 2026).
        && posisiKaryawan(request.resource.data.employeeId) != 'MANDOR'
        && request.resource.data.status == 'MENUNGGU'
        && request.resource.data.keluar == null
        && request.resource.data.kembali == null
        && request.resource.data.diketahuiOleh == null
        && request.resource.data.diputuskanOleh == null
        && request.resource.data.keperluan in ['DINAS', 'PRIBADI']
        && request.resource.data.alasan is string && request.resource.data.alasan.size() > 0
        && request.resource.data.tanggal is string && request.resource.data.tanggal.size() == 10;

      allow update: if (
          // Pemilik: mencatat keluar/kembali, atau membatalkan yang belum dipakai.
          sudahLogin()
          && resource.data.employeeId == karyawanSaya()
          && resource.data.status in ['MENUNGGU', 'DISETUJUI']
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['keluar', 'kembali', 'durasiMenit', 'lebihDuaJam', 'updatedAt'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                && resource.data.status == 'MENUNGGU'
                && resource.data.keluar == null
                && request.resource.data.status == 'DIBATALKAN')
          )
          // Jam keluar/kembali yang sudah tercatat tidak bisa diubah, dan yang
          // baru dicatat wajib berjam server (bukan jam HP).
          && sesiTetapAtauBaru('keluar')
          && sesiTetapAtauBaru('kembali')
        ) || (
          // "Diketahui oleh", sekali saja: atasan langsung si karyawan
          // (atasanId disalin saat izin dibuat), atau HR/Admin sebagai
          // cadangan. Belum ada HRD (10 Okt 2026); semua staf di bawah
          // satu atasan, dan atasan itu di bawah Owner.
          (isHR() || isAdmin() || (sudahLogin() && resource.data.atasanId == karyawanSaya()))
          && resource.data.diketahuiOleh == null
          && resource.data.status in ['MENUNGGU', 'DISETUJUI']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['diketahuiOleh', 'diketahuiPada', 'updatedAt'])
        ) || (
          // Owner: "Disetujui oleh" atau menolak.
          isOwner()
          && resource.data.status == 'MENUNGGU'
          && request.resource.data.status in ['DISETUJUI', 'DITOLAK']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'diputuskanOleh', 'diputuskanPada', 'catatanKeputusan', 'updatedAt'])
        );

      allow delete: if false;
    }

    match /leaveRequests/{pengajuanId} {
      // Finance membaca (tidak mengubah) untuk rekap bulanan dan payroll.
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin()
            && (resource == null || resource.data.employeeId == karyawanSaya()))
        || (sudahLogin() && resource != null && resource.data.atasanId == karyawanSaya());

      // Mengajukan hanya untuk diri sendiri, dan selalu lahir sebagai
      // DIAJUKAN - tidak bisa langsung menyetujui cuti sendiri.
      allow create: if sudahLogin()
        && pengajuanSah()
        && request.resource.data.employeeId == karyawanSaya()
        // Mandor adalah pihak ketiga: tidak ada cuti dan izin (client, 10 Okt 2026).
        && posisiKaryawan(request.resource.data.employeeId) != 'MANDOR'
        && request.resource.data.status == 'DIAJUKAN'
        && request.resource.data.saldoDipotong == false;

      // Dua tahap seperti formulir kertas (client C3, 10 Okt 2026):
      // "Diketahui" oleh atasan langsung (HR/Admin cadangan), baru
      // "Disetujui" oleh HR/Owner/Admin. Pemiliknya sendiri hanya boleh
      // membatalkan, bukan mengubah isinya.
      allow update: if pengajuanSah()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.tanggalMulai == resource.data.tanggalMulai
        && request.resource.data.tanggalSelesai == resource.data.tanggalSelesai
        && request.resource.data.jumlahHari == resource.data.jumlahHari
        && (
          (
            // Tahap 1: atasan langsung menandai diketahui, sekali saja, selagi menunggu.
            (isHR() || isAdmin() || (sudahLogin() && resource.data.atasanId == karyawanSaya()))
            && resource.data.get('diketahuiOleh', null) == null
            && resource.data.status == 'DIAJUKAN'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['diketahuiOleh', 'diketahuiPada', 'updatedAt'])
          ) || (
            // Tahap 2: keputusan. DISETUJUI wajib sudah diketahui, kecuali
            // HR/Admin menandainya sebagai cadangan dalam tulisan yang sama.
            urusKepegawaian()
            && (
              request.resource.data.status != 'DISETUJUI'
              || resource.data.get('diketahuiOleh', null) != null
              || ((isHR() || isAdmin()) && request.resource.data.get('diketahuiOleh', null) != null)
            )
          ) || (
            resource.data.employeeId == karyawanSaya()
            && request.resource.data.status == 'DIBATALKAN'
          )
        );

      allow delete: if false;
    }

    // ---------- pengakuan lembur ----------
    // Lembur hanya dibayar bila ada pengajuan beralasan yang disetujui
    // (9 Okt 2026). Diajukan sendiri (atau oleh mandor untuk anak buahnya)
    // paling lambat 1 hari setelah tanggalnya (client, 10 Okt 2026; semula 7);
    // lewat itu hanya pengelola.
    function lemburSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.tanggal is string && d.tanggal.size() == 10
        && d.jamLembur is number && d.jamLembur > 0
        && d.alasan is string && d.alasan.size() > 0
        && d.terlambat is bool
        && d.sumber in ['SENDIRI', 'MANDOR', 'PENGELOLA']
        // Kosong pada data lama = LEMBUR. MASUK_LIBUR = pengajuan masuk hari libur (10 Okt 2026).
        && d.get('jenis', 'LEMBUR') in ['LEMBUR', 'MASUK_LIBUR']
        && d.status in ['DIAJUKAN', 'DISETUJUI', 'DITOLAK', 'DIBATALKAN'];
    }

    /** Pengajuan masuk hari libur boleh untuk tanggal yang akan datang; batas 1 hari hanya untuk lembur. */
    function masukLibur() {
      return request.resource.data.get('jenis', 'LEMBUR') == 'MASUK_LIBUR';
    }

    /**
     * Karyawan yang ditandai tidak dihitung lembur (employees.tanpaLembur,
     * 10 Okt 2026) tidak bisa diajukan lemburnya oleh siapa pun. Masuk hari
     * libur tetap boleh karena hanya dicatat, tidak dibayar sebagai lembur.
     */
    function bolehDihitungLembur(employeeId) {
      return masukLibur()
        || get(/databases/$(database)/documents/employees/$(employeeId)).data.get('tanpaLembur', false) != true;
    }

    /**
     * Batas 1 hari (BATAS_AJUKAN_LEMBUR_HARI di lib/constants.ts) ditegakkan
     * di server, bukan hanya di formulir.
     * Tanggal lembur "YYYY-MM-DD" adalah tanggal WIB (UTC+7):
     *  - awal harinya   = tengah malam UTC tanggal itu dikurangi 7 jam
     *  - akhir hari ke-1 = tanggal + 1 hari pukul 24.00 WIB
     *                    = tengah malam UTC + 1 hari + 17 jam
     * Tanggal di masa depan ditolak lewat syarat pertama.
     */
    function tanggalLemburMasihBoleh(tanggal) {
      let awal = timestamp.date(int(tanggal.split('-')[0]), int(tanggal.split('-')[1]), int(tanggal.split('-')[2]));
      return awal - duration.value(7, 'h') <= request.time
        && request.time <= awal + duration.value(1, 'd') + duration.value(17, 'h');
    }

    match /overtimeRequests/{lemburId} {
      // Finance membaca karena lembur yang disetujui masuk payroll.
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin() && (resource == null || resource.data.employeeId == karyawanSaya()))
        || (sudahLogin() && resource != null && resource.data.atasanId == karyawanSaya())
        || (isMandor() && resource != null && resource.data.mandorId == profilSaya().employeeId);

      // Selalu lahir DIAJUKAN, belum diputuskan, belum ada jam disetujui.
      allow create: if lemburSah()
        && request.resource.data.status == 'DIAJUKAN'
        && request.resource.data.jamDisetujui == null
        && request.resource.data.diputuskanOleh == null
        && bolehDihitungLembur(request.resource.data.employeeId)
        && (
          // Pengelola mengajukan atas nama siapa pun, tanpa batas waktu
          // (jalur untuk pengajuan yang terlambat).
          (urusKepegawaian() && request.resource.data.sumber == 'PENGELOLA')
          ||
          // Diri sendiri, di dalam batas waktu (masuk libur: tanpa batas,
          // karena diajukan sebelum harinya).
          (sudahLogin()
            && request.resource.data.sumber == 'SENDIRI'
            && request.resource.data.employeeId == karyawanSaya()
            && request.resource.data.terlambat == false
            && (masukLibur() || tanggalLemburMasihBoleh(request.resource.data.tanggal)))
          ||
          // Mandor untuk anak buah yang sedang ditugaskan kepadanya.
          (isMandor()
            && request.resource.data.sumber == 'MANDOR'
            && request.resource.data.terlambat == false
            && request.resource.data.mandorId == profilSaya().employeeId
            && get(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.currentMandorId
                 == profilSaya().employeeId
            && (masukLibur() || tanggalLemburMasihBoleh(request.resource.data.tanggal)))
        );

      // Isi pengajuan beku. Yang boleh berubah hanya keputusannya (HR/Owner/Admin)
      // atau pembatalan oleh pengajunya selagi masih menunggu.
      allow update: if lemburSah()
        && resource.data.status == 'DIAJUKAN'
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.tanggal == resource.data.tanggal
        && request.resource.data.jamMulai == resource.data.jamMulai
        && request.resource.data.jamSelesai == resource.data.jamSelesai
        && request.resource.data.jamLembur == resource.data.jamLembur
        && request.resource.data.alasan == resource.data.alasan
        && request.resource.data.sumber == resource.data.sumber
        && request.resource.data.terlambat == resource.data.terlambat
        && (
          (
            urusKepegawaian()
            && request.resource.data.status in ['DISETUJUI', 'DITOLAK']
            // Jam yang disetujui tidak boleh melebihi yang diajukan.
            && (
              request.resource.data.status == 'DITOLAK'
              || (request.resource.data.jamDisetujui is number
                  && request.resource.data.jamDisetujui > 0
                  && request.resource.data.jamDisetujui <= resource.data.jamLembur)
            )
          )
          ||
          (
            sudahLogin()
            && request.resource.data.status == 'DIBATALKAN'
            && (resource.data.employeeId == karyawanSaya()
                || resource.data.diajukanOleh == emailUser())
          )
        );

      allow delete: if false;
    }

    // ---------- kategori masalah SP ----------
    match /spCategories/{kategoriId} {
      allow read: if pegawaiAktif();
      allow create, update: if urusKepegawaian()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0;
      // Kategori tidak dihapus, cukup dinonaktifkan - surat peringatan
      // lama masih menunjuk ke sini.
      allow delete: if false;
    }

    // ---------- surat peringatan ----------
    function spSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.kategoriId is string && d.kategoriId.size() > 0
        && d.tingkat is number && d.tingkat >= 1 && d.tingkat <= 3
        && d.tanggalTerbit is string && d.tanggalTerbit.size() == 10
        && d.berlakuSampai is string && d.berlakuSampai.size() == 10
        && d.berlakuSampai > d.tanggalTerbit
        && d.uraian is string && d.uraian.size() > 0
        && d.dicabut is bool;
    }

    match /warningLetters/{spId} {
      // Karyawan boleh membaca surat peringatan atas namanya sendiri.
      // Finance membaca untuk kolom SP di slip gaji.
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin()
            && (resource == null || resource.data.employeeId == karyawanSaya()));

      allow create: if urusKepegawaian()
        && spSah()
        // Mandor adalah pihak ketiga: tidak menerima SP (client, 10 Okt 2026).
        && posisiKaryawan(request.resource.data.employeeId) != 'MANDOR'
        && request.resource.data.dicabut == false;

      // Yang boleh berubah hanya pencabutannya. Isi suratnya beku —
      // kalau uraian dan tingkatnya bisa diubah belakangan, catatan
      // kedisiplinan kehilangan artinya.
      allow update: if urusKepegawaian()
        && spSah()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.kategoriId == resource.data.kategoriId
        && request.resource.data.tingkat == resource.data.tingkat
        && request.resource.data.tanggalTerbit == resource.data.tanggalTerbit
        && request.resource.data.berlakuSampai == resource.data.berlakuSampai
        && request.resource.data.uraian == resource.data.uraian;

      allow delete: if false;
    }

    // ---------- kantor ----------
    match /offices/{kantorId} {
      // Semua orang yang absen perlu membacanya untuk mengukur jarak.
      allow read: if pegawaiAktif();
      allow create, update: if urusKepegawaian()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radiusMeter is number
        && request.resource.data.radiusMeter >= 20
        && request.resource.data.radiusMeter <= 2000;
      allow delete: if false;
    }

    // ---------- absensi kantor ----------
    function absenKantorSah() {
      let d = request.resource.data;
      return d.employeeId is string && d.employeeId.size() > 0
        && d.date is string && d.date.size() == 10
        && d.workHours is number && d.workHours >= 0
        && d.terlambatMenit is number && d.terlambatMenit >= 0
        && d.status in ['HADIR', 'SELESAI']
        && d.isOverridden is bool;
    }

    /** Dokumen absen kantor baru: hari ini, semua sesinya berjam server. */
    function sesiKantorBaruSah() {
      return tanggalHariIniWIB(request.resource.data.date)
        && sesiKosongAtauBerjamServer('masuk')
        && sesiKosongAtauBerjamServer('istirahat')
        && sesiKosongAtauBerjamServer('selesaiIstirahat')
        && sesiKosongAtauBerjamServer('pulang');
    }

    /** Ubahan absen kantor oleh pemiliknya: sesi lama utuh, sesi baru berjam server. */
    function sesiKantorTetapAtauBaru() {
      return sesiTetapAtauBaru('masuk')
        && sesiTetapAtauBaru('istirahat')
        && sesiTetapAtauBaru('selesaiIstirahat')
        && sesiTetapAtauBaru('pulang');
    }

    match /officeAttendance/{absenId} {
      // "resource == null" berarti dokumennya belum ada — keadaan normal
      // saat absen pertama hari itu diperiksa lebih dulu. Harus dijawab
      // boleh, bukan dibiarkan jadi galat, karena galat di dalam rules
      // ikut terbaca sebagai penolakan izin.
      allow read: if urusKepegawaian()
        || isFinance()
        || (sudahLogin()
            && (resource == null || resource.data.employeeId == karyawanSaya()))
        // Atasan langsung boleh membaca kehadiran bawahannya. Kolom
        // atasanId disalin saat catatan dibuat, jadi tidak perlu membaca
        // dokumen karyawan lagi untuk memeriksanya.
        || (sudahLogin() && resource != null && resource.data.atasanId == karyawanSaya());

      // Absen hanya untuk diri sendiri. ID wajib "<kode>_<tanggal>",
      // jadi satu orang mustahil punya dua catatan di satu hari — termasuk
      // kalau tombolnya tertekan dua kali.
      // Siapa pun yang absen (termasuk HR/Owner) hanya bisa mencatat hari ini
      // dengan jam server; tidak ada jalur membuat catatan hari lain.
      allow create: if sudahLogin()
        && absenKantorSah()
        && absenId == request.resource.data.employeeId + '_' + request.resource.data.date
        && sesiKantorBaruSah()
        && (urusKepegawaian() || request.resource.data.employeeId == karyawanSaya());

      // Pemiliknya boleh menambah sesi pada catatan hari itu, tetapi tidak
      // boleh menyentuh koreksi dan hasil validasi — itu wilayah Admin.
      // Sesi yang sudah tersimpan tidak pernah diubah lewat jalur ini, juga
      // oleh Admin: koreksi jam masuk ke kolom koreksi*, bukan ke sesinya.
      allow update: if absenKantorSah()
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.date == resource.data.date
        && sesiKantorTetapAtauBaru()
        && (
          urusKepegawaian()
          || (
            resource.data.employeeId == karyawanSaya()
            && tanggalHariIniWIB(resource.data.date)
            && request.resource.data.isOverridden == resource.data.isOverridden
            && request.resource.data.koreksiMasuk == resource.data.koreksiMasuk
            && request.resource.data.koreksiPulang == resource.data.koreksiPulang
            // Catatan lama belum punya kolom koreksi istirahat, jadi dibaca
            // dengan nilai bawaan null supaya tidak jadi galat.
            && request.resource.data.get('koreksiIstirahat', null) == resource.data.get('koreksiIstirahat', null)
            && request.resource.data.get('koreksiSelesaiIstirahat', null) == resource.data.get('koreksiSelesaiIstirahat', null)
            && request.resource.data.hasilValidasi == resource.data.hasilValidasi
          )
        );

      allow delete: if false;
    }

    // ============================================================
    // ================  ALLEGRO PROJECT — ADMIN PROYEK  ===========
    //  Koleksi baru berawalan "ap" supaya tidak pernah bentrok
    //  dengan koleksi EMS. Fase 1: toko, katalog material, dan RAB.
    // ============================================================

    // ---------- apSuppliers (toko / supplier) ----------
    function tokoSah() {
      let d = request.resource.data;
      return d.nama is string && d.nama.size() > 0
        && d.status in ['BARU', 'TERVERIFIKASI', 'BLOKIR'];
    }

    /** Rekening toko sama persis dengan yang tersimpan (kolom kosong = ''). */
    function rekeningTokoTetap() {
      let lama = resource.data;
      let baru = request.resource.data;
      return baru.get('bankPpn', '') == lama.get('bankPpn', '')
        && baru.get('rekPpn', '') == lama.get('rekPpn', '')
        && baru.get('atasNamaPpn', '') == lama.get('atasNamaPpn', '')
        && baru.get('bankNonPpn', '') == lama.get('bankNonPpn', '')
        && baru.get('rekNonPpn', '') == lama.get('rekNonPpn', '')
        && baru.get('atasNamaNonPpn', '') == lama.get('atasNamaNonPpn', '');
    }

    match /apSuppliers/{tokoId} {
      // Dokumen toko memuat nomor rekening, jadi hanya dibaca peran yang
      // memang punya menu Toko (lihat "toko.lihat" di roles.js).
      allow read: if atasanProyek()
        || berperanProyek(['PURCHASING', 'ADMIN_PROYEK', 'ADMIN_DATA', 'PLANNER']);

      // Purchasing boleh mendaftarkan toko, tetapi selalu berstatus BARU.
      // Mengesahkan toko (TERVERIFIKASI) hanya Head Admin / Direksi —
      // itulah pengganti "survei toko" yang selama ini lewat chat.
      allow create: if tokoSah()
        && (
          atasanProyek()
          || (berperanProyek(['PURCHASING']) && request.resource.data.status == 'BARU')
        );

      // Purchasing boleh memperbarui datanya, asal tidak mengubah status.
      // Kalau rekeningnya ikut diganti, toko WAJIB turun lagi ke BARU supaya
      // disahkan ulang — mengganti rekening toko yang sudah sah adalah cara
      // klasik membelokkan pembayaran.
      allow update: if tokoSah()
        && (
          atasanProyek()
          || (berperanProyek(['PURCHASING'])
              && (
                (request.resource.data.status == resource.data.status && rekeningTokoTetap())
                || (resource.data.status in ['BARU', 'TERVERIFIKASI']
                    && request.resource.data.status == 'BARU')
              ))
        );

      // Toko tidak dihapus sembarangan; cukup diblokir. Hanya atasan
      // yang boleh menghapus, itu pun untuk salah input.
      allow delete: if atasanProyek();
    }

    // ---------- apMaterials (katalog material) ----------
    function materialSah() {
      let d = request.resource.data;
      return d.nama is string && d.nama.size() > 0
        && d.satuan is string && d.satuan.size() > 0;
    }

    match /apMaterials/{materialId} {
      allow read: if wargaProyek();
      allow create, update: if materialSah()
        && (atasanProyek() || berperanProyek(['PLANNER', 'PURCHASING']));
      allow delete: if atasanProyek();
    }

    // ---------- apRabHeaders (satu dokumen per import RAB) ----------
    function bolehImportRab() {
      return atasanProyek() || berperanProyek(['QS']);
    }

    match /apRabHeaders/{rabId} {
      allow read: if wargaProyek();

      allow create: if bolehImportRab()
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.totalRab is number
        && request.resource.data.jumlahItem is number
        && request.resource.data.aktif is bool;

      // Yang boleh berubah hanya penanda versi aktif. Angka RAB beku:
      // kalau nilainya bisa diketik ulang, audit biaya kehilangan dasar.
      // Revisi dilakukan dengan import versi baru.
      allow update: if bolehImportRab()
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.versi == resource.data.versi
        && request.resource.data.totalRab == resource.data.totalRab
        && request.resource.data.jumlahItem == resource.data.jumlahItem;

      allow delete: if false;
    }

    // ---------- apRabItems (baris RAB) ----------
    match /apRabItems/{itemId} {
      allow read: if wargaProyek();

      allow create: if bolehImportRab()
        && request.resource.data.rabId is string
        && request.resource.data.rabId.size() > 0
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.totalHarga is number;

      // Baris RAB adalah salinan dokumen anggaran: tambah-saja.
      allow update, delete: if false;
    }


    // ---------- [ADMIN PROYEK] Fase 2: PB, PO, hutang, klaim, transfer ----------

    function pengajuProyek() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','PLANNER','PIC','KOORDINATOR']);
    }
    function purchasing() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','PURCHASING']);
    }
    function adminProyek() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','ADMIN_PROYEK']);
    }
    function kasir() {
      // Yang boleh menandai sudah dibayar & mengupload bukti transfer.
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','ADMIN_DATA']);
    }

    // ---------- apMaterialRequests (PB) ----------
    match /apMaterialRequests/{pbId} {
      allow read: if wargaProyek();

      allow create: if pengajuProyek()
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.status == 'DIAJUKAN'
        && request.resource.data.items.size() > 0;

      // Verifikasi PB hanya Planner / Head Admin. Purchasing boleh menandai
      // "DIPROSES" saat PB dipakai jadi PO. Isi permintaannya tidak boleh
      // diubah setelah diajukan, supaya yang disetujui = yang diminta.
      allow update: if request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.items == resource.data.items
        && (
          (
            (superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','PLANNER']))
            && resource.data.status == 'DIAJUKAN'
            && request.resource.data.status in ['DIVERIFIKASI','DITOLAK']
          ) || (
            // Purchasing hanya boleh memproses PB yang SUDAH diverifikasi.
            purchasing()
            && (
              (resource.data.status == 'DIVERIFIKASI' && request.resource.data.status == 'DIPROSES')
              || (resource.data.status == 'DIPROSES' && request.resource.data.status in ['DIPROSES','SELESAI'])
            )
          )
        );

      allow delete: if false;
    }

    // ---------- apPurchaseOrders (PO + nota) ----------
    match /apPurchaseOrders/{poId} {
      // PO memuat harga beli; Staf Lapangan tidak punya menu PO.
      allow read: if atasanProyek()
        || berperanProyek(['PURCHASING','ADMIN_PROYEK','ADMIN_DATA','PLANNER','QS','KOORDINATOR','PIC']);

      // PO lahir langsung sebagai MENUNGGU_APPROVAL: tidak ada PO yang
      // "sudah disetujui" sejak awal.
      allow create: if purchasing()
        && request.resource.data.status == 'MENUNGGU_APPROVAL'
        && request.resource.data.projectCode is string
        && request.resource.data.supplierId is string
        && request.resource.data.subtotal is number
        && request.resource.data.items.size() > 0;

      allow update: if (
          // Approval: hanya Head Admin / Direksi, dan nilainya tidak boleh
          // ikut berubah saat menyetujui.
          atasanProyek()
          && resource.data.status == 'MENUNGGU_APPROVAL'
          && request.resource.data.status in ['DISETUJUI','DIKEMBALIKAN']
          && request.resource.data.subtotal == resource.data.subtotal
          && request.resource.data.supplierId == resource.data.supplierId
          && request.resource.data.items == resource.data.items
        ) || (
          // Purchasing: memperbaiki PO yang dikembalikan, mengisi nota,
          // meneruskan pembayaran, dan menandai pengiriman.
          purchasing()
          && request.resource.data.projectCode == resource.data.projectCode
          // Nilai, toko, dan item hanya boleh diperbaiki selagi PO
          // DIKEMBALIKAN. Setelah disetujui semuanya beku — kalau tidak,
          // persetujuan atasan bisa diakali dengan mengubah angka belakangan.
          && (resource.data.status == 'DIKEMBALIKAN'
              || (request.resource.data.subtotal == resource.data.subtotal
                  && request.resource.data.supplierId == resource.data.supplierId
                  && request.resource.data.items == resource.data.items))
          && (
            (resource.data.status == 'DIKEMBALIKAN' && request.resource.data.status == 'MENUNGGU_APPROVAL')
            || (resource.data.status in ['DISETUJUI','NOTA_DITERIMA']
                && request.resource.data.status in ['NOTA_DITERIMA','NOTA_TERVERIFIKASI']
                // Foto nota boleh kosong, tetapi kalau diisi wajib dari Cloudinary.
                && (request.resource.data.nota.get('fotoUrl', '') == ''
                    || fotoCloudinary(request.resource.data.nota.fotoUrl))
                // Nota baru boleh dinyatakan terverifikasi bila nilainya
                // tidak melebihi PO yang disetujui (Rp 1 = pembulatan).
                && (request.resource.data.status != 'NOTA_TERVERIFIKASI'
                    || (request.resource.data.nota.nilaiNota is number
                        && request.resource.data.nota.nilaiNota <= resource.data.subtotal + 1)))
            // Sesudah terverifikasi, isi notanya ikut beku.
            || (resource.data.status == 'NOTA_TERVERIFIKASI'
                && request.resource.data.status in ['DIBAYAR','KONTRA_BON']
                && request.resource.data.get('nota', null) == resource.data.get('nota', null))
            || (resource.data.status in ['DIBAYAR','KONTRA_BON'] && request.resource.data.status == 'DIKIRIM'
                && request.resource.data.get('nota', null) == resource.data.get('nota', null))
          )
        ) || (
          // Penerimaan barang di lokasi boleh dicatat PIC / Koordinator.
          (purchasing() || berperanProyek(['PIC','KOORDINATOR']))
          && resource.data.status in ['DIBAYAR','KONTRA_BON','DIKIRIM']
          && request.resource.data.status == 'DITERIMA'
          && request.resource.data.subtotal == resource.data.subtotal
        );

      allow delete: if false;
    }

    // ---------- apDebts (kontra bon) ----------
    match /apDebts/{hutangId} {
      allow read: if atasanProyek()
        || berperanProyek(['PURCHASING','ADMIN_PROYEK','ADMIN_DATA']);

      // Lahir dari PO tempo (poId terisi) oleh Purchasing, atau dicatat manual
      // (poId kosong, nota tempo tanpa PO) oleh Purchasing / Admin Proyek.
      // Rincian item per pos RAB wajib ada supaya masuk laporan realisasi.
      allow create: if (purchasing() || adminProyek())
        && request.resource.data.poId is string
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.jatuhTempo is string
        && request.resource.data.get('items', []) is list
        && request.resource.data.status == 'BELUM_JATUH_TEMPO';

      // Nominal, supplier, item, dan jatuh tempo beku. Yang bergerak hanya status.
      allow update: if (adminProyek() || purchasing())
        && request.resource.data.nominal == resource.data.nominal
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.jatuhTempo == resource.data.jatuhTempo
        && request.resource.data.poId == resource.data.poId
        && request.resource.data.get('items', null) == resource.data.get('items', null)
        // Alurnya searah: belum dibayar -> diajukan -> lunas. Hutang tidak
        // bisa langsung dinyatakan lunas tanpa pernah diajukan pembayarannya.
        && (
          (resource.data.status in ['BELUM_JATUH_TEMPO','JATUH_TEMPO']
            && request.resource.data.status in ['BELUM_JATUH_TEMPO','JATUH_TEMPO','DIAJUKAN'])
          || (resource.data.status == 'DIAJUKAN'
            && request.resource.data.status in ['DIAJUKAN','LUNAS'])
        );

      allow delete: if false;
    }

    // ---------- apClaims (klaim / reimburse) ----------
    match /apClaims/{klaimId} {
      // Klaim memuat rekening pribadi pengaju. QS & Planner ikut membaca
      // karena laporan RAB vs realisasi menghitung klaim.
      allow read: if atasanProyek()
        || berperanProyek(['ADMIN_PROYEK','ADMIN_DATA','PIC','KOORDINATOR','QS','PLANNER']);

      // Wajib berfoto bukti sejak awal, lahir sebagai DIAJUKAN, dan memuat
      // rincian barang (tiap baris ditandai pos RAB) — nominal = jumlah item.
      allow create: if (superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','ADMIN_PROYEK','PIC','KOORDINATOR']))
        && request.resource.data.status == 'DIAJUKAN'
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && fotoCloudinary(request.resource.data.fotoUrl);

      // Nominal, rincian item, dan bukti tidak boleh diubah saat diperiksa/disetujui.
      allow update: if (adminProyek() || atasanProyek())
        && request.resource.data.nominal == resource.data.nominal
        && request.resource.data.get('items', null) == resource.data.get('items', null)
        && request.resource.data.fotoUrl == resource.data.fotoUrl
        && request.resource.data.diajukanOleh == resource.data.diajukanOleh
        && request.resource.data.projectCode == resource.data.projectCode
        // Rekening penerima ikut beku: yang dibayar = yang diajukan.
        && request.resource.data.get('penerima', null) == resource.data.get('penerima', null)
        // Alur status dijaga di sini. DIBAYAR hanya bisa sesudah DISETUJUI.
        && (
          (resource.data.status == 'DIAJUKAN'
            && request.resource.data.status in ['DIPERIKSA','DIKEMBALIKAN'])
          || (resource.data.status == 'DIPERIKSA'
            && request.resource.data.status == 'DIKEMBALIKAN')
          // Menyetujui hanya Head Admin / Direksi, dan bukan klaimnya sendiri.
          || (resource.data.status in ['DIAJUKAN','DIPERIKSA']
            && request.resource.data.status == 'DISETUJUI'
            && atasanProyek()
            && resource.data.diajukanOleh != emailUser())
          || (resource.data.status == 'DISETUJUI'
            && request.resource.data.status == 'DIBAYAR')
        );

      allow delete: if false;
    }

    // ---------- apPaymentRequests (antrean pengajuan transfer) ----------
    /** Pengajuan transfer ini lahir dari klaim yang sah: klaimnya sudah
        disetujui, angka & penerimanya sama, dan klaim itu bukan milik
        orang yang sekarang hendak menyetujui transfernya. */
    function transferDariKlaimSah() {
      let klaim = get(/databases/$(database)/documents/apClaims/$(resource.data.refId)).data;
      return resource.data.jenis == 'KLAIM'
        && klaim.status in ['DISETUJUI','DIBAYAR']
        && klaim.nominal == resource.data.nominal
        && klaim.get('penerima', null) == resource.data.get('penerima', null)
        && klaim.diajukanOleh != emailUser();
    }

    match /apPaymentRequests/{transferId} {
      // Antrean transfer memuat rekening penerima. QS & Planner ikut membaca
      // karena laporan RAB vs realisasi menghitung pembayaran gaji.
      allow read: if atasanProyek()
        || berperanProyek(['PURCHASING','ADMIN_PROYEK','ADMIN_DATA','QS','PLANNER']);

      allow create: if (superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','PURCHASING','ADMIN_PROYEK','ADMIN_DATA']))
        && request.resource.data.status == 'DIAJUKAN'
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.jenis in ['NOTA','KONTRA_BON','GAJI','KLAIM','LAIN']
        // Nama pengaju tidak bisa dipalsukan; dipakai untuk aturan
        // "pengaju tidak boleh menyetujui pengajuannya sendiri".
        && request.resource.data.diajukanOleh == emailUser();

      allow update: if request.resource.data.get('diajukanOleh', '') == resource.data.get('diajukanOleh', '')
        && request.resource.data.jenis == resource.data.jenis
        && request.resource.data.get('refId', '') == resource.data.get('refId', '')
        // Rincian item (dengan pos RAB-nya) ikut beku sejak diajukan.
        && request.resource.data.get('items', null) == resource.data.get('items', null)
        && ((
          // Approval final: Head Admin / Direksi. Nominal & penerima beku,
          // supaya angka tidak bisa digeser setelah diperiksa.
          atasanProyek()
          && resource.data.status in ['DIAJUKAN','DIKEMBALIKAN']
          && request.resource.data.status in ['DISETUJUI','DIKEMBALIKAN']
          && request.resource.data.nominal == resource.data.nominal
          && request.resource.data.penerima == resource.data.penerima
          // Empat mata: yang mengajukan tidak boleh menyetujui sendiri.
          // Pengecualian: transfer yang otomatis lahir saat klaim ORANG LAIN
          // disetujui — pengajunya memang si penyetuju klaim.
          && (request.resource.data.status != 'DISETUJUI'
              || resource.data.get('diajukanOleh', '') != emailUser()
              || transferDariKlaimSah())
        ) || (
          // Upload bukti transfer setelah Direksi Finance mentransfer.
          kasir()
          && resource.data.status == 'DISETUJUI'
          && request.resource.data.status == 'DIBAYAR'
          && request.resource.data.nominal == resource.data.nominal
          && request.resource.data.penerima == resource.data.penerima
          && fotoCloudinary(request.resource.data.buktiTfUrl)
        ) || (
          // Pencocokan dengan mutasi giro.
          kasir()
          && resource.data.status in ['DIBAYAR','SELISIH']
          && request.resource.data.status in ['TERCOCOK','SELISIH']
          && request.resource.data.nominal == resource.data.nominal
          && request.resource.data.penerima == resource.data.penerima
        ));

      allow delete: if false;
    }


    // ---------- [ADMIN PROYEK] Fase 3: mutasi giro, faktur pajak, refund ----------

    // ---------- apBankMutations (mutasi rekening giro) ----------
    match /apBankMutations/{mutasiId} {
      // Mutasi rekening memuat seluruh pergerakan uang perusahaan, jadi
      // hanya dibaca yang mengurusnya: Head Admin, Direksi, dan Admin Data.
      allow read: if atasanProyek() || berperanProyek(['ADMIN_DATA']);

      allow create: if (atasanProyek() || berperanProyek(['ADMIN_DATA']))
        && request.resource.data.tanggal is string
        && request.resource.data.tanggal.size() == 10
        && request.resource.data.status in ['TERCOCOK','SELISIH','BUKAN_PENGELUARAN'];

      // Hasil import bersifat tambah-saja: catatan bank tidak boleh
      // diubah belakangan, karena itulah pembanding yang jujur.
      allow update, delete: if false;
    }

    // ---------- apTaxInvoices (faktur pajak atas nota PPN) ----------
    match /apTaxInvoices/{fakturId} {
      allow read: if atasanProyek() || berperanProyek(['PURCHASING','ADMIN_DATA']);

      allow create: if (atasanProyek() || berperanProyek(['PURCHASING']))
        && request.resource.data.poId is string
        && request.resource.data.status == 'MENUNGGU';

      // Nilai dan nota sumbernya beku; yang bergerak hanya status faktur.
      allow update: if (atasanProyek() || berperanProyek(['PURCHASING']))
        && request.resource.data.poId == resource.data.poId
        && request.resource.data.nilai == resource.data.nilai
        && request.resource.data.nomorNota == resource.data.nomorNota
        && request.resource.data.status in ['MENUNGGU','DITERIMA','TERKIRIM']
        // Menandai "terkirim ke pajak" wajib ada nomor faktur & fotonya.
        && (request.resource.data.status != 'TERKIRIM'
            || (request.resource.data.nomorFaktur is string
                && request.resource.data.nomorFaktur.size() > 0
                && fotoCloudinary(request.resource.data.fotoFakturUrl)));

      allow delete: if false;
    }

    // ---------- apRefunds (saldo mengendap marketplace) ----------
    match /apRefunds/{refundId} {
      allow read: if atasanProyek() || berperanProyek(['PURCHASING','ADMIN_DATA']);
      allow create: if (atasanProyek() || berperanProyek(['PURCHASING','ADMIN_DATA']))
        && request.resource.data.nominal is number
        && request.resource.data.nominal > 0
        && request.resource.data.status == 'MENGENDAP';
      allow update: if (atasanProyek() || berperanProyek(['PURCHASING','ADMIN_DATA']))
        && request.resource.data.nominal == resource.data.nominal
        && request.resource.data.status in ['MENGENDAP','DIAJUKAN','KEMBALI'];
      allow delete: if false;
    }

    // ================= [ADMIN PROYEK] Fase 4 — lapangan =================

    // ---------- apQcChecks (lembar cek mutu) ----------
    match /apQcChecks/{qcId} {
      allow read: if wargaProyek();

      allow create: if (atasanProyek()
          || berperanProyek(['PIC','KOORDINATOR','STAF_LAPANGAN','QS']))
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.dibuatOleh == emailUser();

      // Lembar boleh dikoreksi oleh pembuatnya atau atasan; proyek & pembuat beku.
      allow update: if (atasanProyek()
          || (berperanProyek(['PIC','KOORDINATOR','STAF_LAPANGAN','QS'])
              && resource.data.dibuatOleh == emailUser()))
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.dibuatOleh == resource.data.dibuatOleh
        && request.resource.data.items is list;

      allow delete: if atasanProyek();
    }

    // ---------- apFindings (temuan & perbaikan) ----------
    match /apFindings/{temuanId} {
      allow read: if wargaProyek();

      allow create: if (atasanProyek()
          || berperanProyek(['PIC','KOORDINATOR','STAF_LAPANGAN','QS']))
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.uraian is string
        && request.resource.data.uraian.size() > 0
        // Temuan selalu lahir sebagai BARU, tidak bisa langsung dianggap beres.
        && request.resource.data.status == 'BARU'
        && request.resource.data.riwayat is list;

      allow update: if wargaProyek()
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.uraian == resource.data.uraian
        && request.resource.data.status in ['BARU','DIKERJAKAN','DIPERBAIKI','DIVERIFIKASI','DITOLAK']
        // Riwayat hanya boleh bertambah, tidak boleh dipangkas.
        && request.resource.data.riwayat is list
        && request.resource.data.riwayat.size() >= resource.data.riwayat.size()
        // Alur status dijaga di sini, bukan cuma di layar.
        && (
          (resource.data.status == 'BARU'
            && request.resource.data.status in ['BARU','DIKERJAKAN','DIPERBAIKI'])
          || (resource.data.status == 'DIKERJAKAN'
            && request.resource.data.status in ['DIKERJAKAN','DIPERBAIKI'])
          || (resource.data.status == 'DIPERBAIKI'
            && request.resource.data.status in ['DIPERBAIKI','DIVERIFIKASI','DITOLAK'])
          || (resource.data.status == 'DITOLAK'
            && request.resource.data.status in ['DITOLAK','DIKERJAKAN','DIPERBAIKI'])
          // DIVERIFIKASI adalah titik akhir.
          || (resource.data.status == 'DIVERIFIKASI'
            && request.resource.data.status == 'DIVERIFIKASI')
        )
        // Menyatakan "sudah diperbaiki" wajib melampirkan foto sesudah.
        && (request.resource.data.status != 'DIPERBAIKI'
            || resource.data.status == 'DIPERBAIKI'
            || fotoCloudinary(request.resource.data.fotoSesudahUrl))
        // Verifikasi & penolakan hanya boleh oleh pemeriksa/atasan.
        && (request.resource.data.status == resource.data.status
            || !(request.resource.data.status in ['DIVERIFIKASI','DITOLAK'])
            || atasanProyek()
            || berperanProyek(['QS','KOORDINATOR']));

      allow delete: if atasanProyek();
    }

    // ---------- apBast (berita acara serah terima) ----------
    match /apBast/{bastId} {
      allow read: if wargaProyek();
      // [ADMIN PROYEK] Fase 5 — klien ikut menandatangani BAST, jadi boleh
      // melihat BAST proyeknya yang sudah sah.
      allow read: if klienAktif()
        && resource.data.projectCode in proyekKlienSaya()
        && resource.data.status == 'DITANDATANGANI';

      allow create: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','QS','KOORDINATOR']))
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.nomor is string
        && request.resource.data.nomor.size() > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.nilai is number
        && request.resource.data.nilai >= 0
        // BAST lahir menunggu tanda tangan, tidak bisa langsung sah.
        && request.resource.data.status == 'MENUNGGU_TANDA_TANGAN'
        && request.resource.data.dibuatOleh == emailUser();

      allow update: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','QS','KOORDINATOR','PIC']))
        // Isi pokok BAST beku sejak dibuat.
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.nomor == resource.data.nomor
        && request.resource.data.items == resource.data.items
        && request.resource.data.nilai == resource.data.nilai
        && request.resource.data.dibuatOleh == resource.data.dibuatOleh
        && request.resource.data.status in ['MENUNGGU_TANDA_TANGAN','DITANDATANGANI','DIBATALKAN']
        // Yang sudah ditandatangani tidak bisa diutak-atik lagi.
        && resource.data.status != 'DITANDATANGANI'
        // Menyatakan sah wajib dua tanda tangan dan hak tanda tangan.
        && (request.resource.data.status != 'DITANDATANGANI'
            || (fotoCloudinary(request.resource.data.ttdPerusahaanUrl)
                && fotoCloudinary(request.resource.data.ttdKlienUrl)
                && (atasanProyek() || berperanProyek(['KOORDINATOR','PIC']))));

      allow delete: if false;
    }

    // ================= [ADMIN PROYEK] Fase 5 — portal klien =================

    // ---------- apDailyReports (laporan harian lapangan) ----------
    match /apDailyReports/{laporanId} {
      allow read: if wargaProyek();
      // Klien hanya melihat laporan proyeknya yang sudah TERBIT.
      allow read: if klienAktif()
        && resource.data.projectCode in proyekKlienSaya()
        && resource.data.status == 'TERBIT';

      allow create: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','PIC','KOORDINATOR','STAF_LAPANGAN']))
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.tanggal is string
        && request.resource.data.pekerjaan is string
        && request.resource.data.pekerjaan.size() > 0
        // Laporan lahir sebagai draft; menerbitkan adalah langkah tersendiri.
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.dibuatOleh == emailUser();

      allow update: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','PIC','KOORDINATOR','STAF_LAPANGAN']))
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.tanggal == resource.data.tanggal
        && request.resource.data.dibuatOleh == resource.data.dibuatOleh
        && request.resource.data.status in ['DRAFT','TERBIT']
        // Menerbitkan ke klien hanya boleh oleh yang berwenang.
        && (request.resource.data.status == resource.data.status
            || atasanProyek()
            || berperanProyek(['ADMIN_PROYEK','KOORDINATOR']));

      // Yang sudah terbit tidak boleh dihapus — klien sudah melihatnya.
      allow delete: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','PIC','KOORDINATOR','STAF_LAPANGAN']))
        && resource.data.status != 'TERBIT';
    }

    // ---------- apTours (tur virtual 360°) ----------
    match /apTours/{turId} {
      allow read: if wargaProyek();
      allow read: if klienAktif()
        && resource.data.projectCode in proyekKlienSaya()
        && resource.data.status == 'TERBIT';

      allow create: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','KOORDINATOR']))
        && request.resource.data.projectCode is string
        && request.resource.data.projectCode.size() > 0
        && request.resource.data.judul is string
        && request.resource.data.judul.size() > 0
        && request.resource.data.scenes is list
        && request.resource.data.scenes.size() > 0
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.dibuatOleh == emailUser();

      allow update: if (atasanProyek()
          || berperanProyek(['ADMIN_PROYEK','KOORDINATOR']))
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.dibuatOleh == resource.data.dibuatOleh
        && request.resource.data.scenes is list
        && request.resource.data.status in ['DRAFT','TERBIT'];

      allow delete: if (atasanProyek() || berperanProyek(['ADMIN_PROYEK','KOORDINATOR']))
        && resource.data.status != 'TERBIT';
    }

    // ---------- apAuditLog (jejak audit aksi sensitif) ----------
    // Append-only: setiap warga aplikasi boleh menambah entri atas aksinya
    // sendiri (oleh == emailnya), tapi TIDAK ADA YANG BOLEH mengubah atau
    // menghapus entri yang sudah tersimpan — itulah yang membuatnya "audit".
    // Hanya atasan (Super Admin / Direksi / Head Admin) yang boleh membaca.
    match /apAuditLog/{logId} {
      allow read: if atasanProyek();
      allow create: if wargaProyek()
        && request.resource.data.aksi is string && request.resource.data.aksi.size() > 0
        && request.resource.data.koleksi is string && request.resource.data.koleksi.size() > 0
        && request.resource.data.oleh == emailUser();
      allow update, delete: if false;
    }

    // ================= [ADMIN PROYEK] Modul Aset & Alat — Tahap A =================
    // Pengelola gudang = LOGISTIK (Logistik SPV, keputusan 10 Okt 2026), dengan
    // Head Admin / Admin Proyek / Purchasing sebagai pengganti. KLIEN tidak pernah
    // masuk sini karena semua hak di bawah memakai wargaProyek()/berperanProyek().
    function pengelolaGudang() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','LOGISTIK','ADMIN_PROYEK','PURCHASING']);
    }

    function asetSah() {
      let d = request.resource.data;
      return d.kode is string && d.kode.size() > 0
        && d.nama is string && d.nama.size() > 0
        && d.kategori is string && d.kategori.size() > 0
        && d.jenis in ['UNIT','STOK','HABIS_PAKAI']
        && d.kepemilikan in ['MILIK','SEWA']
        && d.get('kelas', 'B') in ['A','B','C']
        && d.lokasiId is string && d.lokasiId.size() > 0
        && d.status in ['TERSEDIA','DIPINJAM','SERVIS','RUSAK','HILANG','AFKIR']
        && d.hargaBeli is number && d.hargaBeli >= 0
        && d.jumlahTotal is number && d.jumlahTotal >= 0
        // Foto boleh kosong; kalau diisi wajib dari Cloudinary.
        && (d.get('fotoUrl', '') == '' || fotoCloudinary(d.fotoUrl));
    }

    /** Peminjaman sesudah batch ini (alat dan peminjaman ditulis bersama). */
    function pinjamanSesudah(id) {
      return getAfter(/databases/$(database)/documents/apAssetLoans/$(id)).data;
    }

    // ---------- apAssets (master alat) ----------
    match /apAssets/{asetId} {
      allow read: if wargaProyek();

      // Alat baru selalu TERSEDIA di gudang, belum dipegang siapa pun. Status
      // lain hanya lahir lewat transaksi (Tahap B–D), bukan diketik di form.
      allow create: if pengelolaGudang() && asetSah()
        && request.resource.data.status == 'TERSEDIA'
        && request.resource.data.get('projectCode', '') == ''
        && request.resource.data.get('pemegangEmail', '') == '';

      // Tahap A: pengelola gudang mengubah data master dan memindahkan antar
      // gudang. Status, proyek, dan pemegang BEKU di sini.
      allow update: if pengelolaGudang() && asetSah()
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('projectCode', '') == resource.data.get('projectCode', '')
        && request.resource.data.get('pemegangEmail', '') == resource.data.get('pemegangEmail', '')
        && request.resource.data.get('jumlahDiProyek', {}) == resource.data.get('jumlahDiProyek', {});

      // Tahap B: status/proyek/pemegang/jumlahDiProyek hanya bergerak BERSAMA
      // dokumen peminjaman (satu batch). Data master lainnya beku di jalur ini.
      // getAfter() membaca keadaan peminjaman sesudah batch, sehingga alat yang
      // ditulis DIPINJAM wajib punya peminjaman yang memang sudah BERJALAN.
      allow update: if wargaProyek()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status','projectCode','pemegangEmail','pemegangNama','pinjamanId',
             'jumlahDiProyek','skorTerakhir','lokasiId','updatedAt','updatedBy'])
        && request.resource.data.status in ['TERSEDIA','DIPINJAM','RUSAK']
        && (
          // UNIT keluar / pindah: peminjaman yang ditunjuk harus BERJALAN & berproyek sama.
          (request.resource.data.status == 'DIPINJAM'
            && request.resource.data.pinjamanId is string
            && request.resource.data.pinjamanId.size() > 0
            && pinjamanSesudah(request.resource.data.pinjamanId).status == 'BERJALAN'
            && pinjamanSesudah(request.resource.data.pinjamanId).projectCode == request.resource.data.projectCode)
          ||
          // UNIT kembali (TERSEDIA / RUSAK): peminjaman asalnya harus sudah DIKEMBALIKAN.
          (resource.data.status == 'DIPINJAM'
            && request.resource.data.status in ['TERSEDIA','RUSAK']
            && request.resource.data.get('projectCode', '') == ''
            && request.resource.data.get('pemegangEmail', '') == ''
            && resource.data.get('pinjamanId', '') != ''
            && pinjamanSesudah(resource.data.pinjamanId).status == 'DIKEMBALIKAN')
          ||
          // STOK / HABIS_PAKAI: hanya jumlahDiProyek yang bergeser, status tetap,
          // dan pinjamanId menunjuk peminjaman yang sedang diproses di batch ini.
          (resource.data.jenis != 'UNIT'
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('projectCode', '') == resource.data.get('projectCode', '')
            && request.resource.data.get('pemegangEmail', '') == resource.data.get('pemegangEmail', '')
            && request.resource.data.pinjamanId is string
            && request.resource.data.pinjamanId.size() > 0
            && pinjamanSesudah(request.resource.data.pinjamanId).status in ['BERJALAN','DIKEMBALIKAN','DIPINDAHKAN'])
        );

      // Alat tidak dihapus; yang salah input dinonaktifkan lewat AFKIR (Tahap D).
      // Sementara itu atasan boleh menghapus salah input yang belum pernah bergerak.
      allow delete: if atasanProyek() && resource.data.status == 'TERSEDIA';
    }

    // ---------- apAssetLocations (gudang & sub-gudang) ----------
    // ID dokumen = kode lokasi (GJKT, GJKT-A, GBDG). Tidak dihapus — alat lama
    // masih menunjuk ke sini — cukup dinonaktifkan.
    match /apAssetLocations/{lokasiId} {
      allow read: if wargaProyek();
      allow create, update: if (atasanProyek() || berperanProyek(['LOGISTIK']))
        && request.resource.data.nama is string && request.resource.data.nama.size() > 0
        && request.resource.data.induk is string
        && request.resource.data.induk != lokasiId
        && request.resource.data.aktif is bool;
      allow delete: if false;
    }

    // ---------- apAssetCategories (kategori alat) ----------
    match /apAssetCategories/{kategoriId} {
      allow read: if wargaProyek();
      allow create, update: if pengelolaGudang()
        && request.resource.data.nama is string && request.resource.data.nama.size() > 0
        && request.resource.data.aktif is bool;
      allow delete: if false;
    }

    // ---------- apAssetLogs (buku mutasi alat) ----------
    // Tambah-saja, seperti apAuditLog: dibuat bersama transaksinya atas nama
    // pelakunya sendiri, tidak pernah diubah atau dihapus.
    match /apAssetLogs/{logId} {
      allow read: if wargaProyek();
      allow create: if wargaProyek()
        && request.resource.data.assetId is string && request.resource.data.assetId.size() > 0
        && request.resource.data.jenis is string && request.resource.data.jenis.size() > 0
        && request.resource.data.oleh == emailUser();
      allow update, delete: if false;
    }

    // ---------- apAssetLoans (peminjaman alat, FORM-LOG/INV) ----------
    // Alur: DIAJUKAN → DIKETAHUI (pengawas) → DISETUJUI (gudang) → KELUAR (gudang
    // serahkan) → BERJALAN (peminjam/pengaju konfirmasi terima) → DIKEMBALIKAN
    // (gudang terima) atau DIPINDAHKAN (ke peminjaman baru atas nama PIC lain).
    function pengawasAset() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','DIREKSI','HEAD_ADMIN','KOORDINATOR','ADMIN_PROYEK']);
    }
    function pengajuAset() {
      return superProyek() || berperanProyek(['SUPER_ADMIN','HEAD_ADMIN','ADMIN_PROYEK','PIC','KOORDINATOR','STAF_LAPANGAN','LOGISTIK']);
    }
    function pinjamSah() {
      let d = request.resource.data;
      return d.nomor is string && d.nomor.size() > 0
        && d.projectCode is string && d.projectCode.size() > 0
        && d.peminjamNama is string && d.peminjamNama.size() > 0
        && d.tanggalPinjam is string && d.tanggalPinjam.size() == 10
        && d.items is list && d.items.size() > 0
        && d.riwayat is list
        && d.status in ['DIAJUKAN','DIKETAHUI','DISETUJUI','KELUAR','BERJALAN','DIKEMBALIKAN','DIPINDAHKAN','DITOLAK','DIBATALKAN'];
    }
    /** Isi pokok peminjaman beku sejak diajukan. */
    function pinjamIntiTetap() {
      return request.resource.data.nomor == resource.data.nomor
        && request.resource.data.projectCode == resource.data.projectCode
        && request.resource.data.diajukanOleh == resource.data.diajukanOleh
        && request.resource.data.peminjamNama == resource.data.peminjamNama
        && request.resource.data.riwayat.size() >= resource.data.riwayat.size();
    }

    match /apAssetLoans/{pinjamId} {
      allow read: if wargaProyek();

      // Lahir DIAJUKAN atas nama pengaju; atau langsung BERJALAN bila hasil
      // "pindah antar proyek" (asalPinjamanId menunjuk peminjaman yang DIPINDAHKAN
      // dalam batch yang sama).
      allow create: if pengajuAset() && pinjamSah()
        && request.resource.data.diajukanOleh == emailUser()
        && (
          request.resource.data.status == 'DIAJUKAN'
          || (request.resource.data.status == 'BERJALAN'
              && request.resource.data.asalPinjamanId is string
              && request.resource.data.asalPinjamanId.size() > 0
              && pinjamanSesudah(request.resource.data.asalPinjamanId).status == 'DIPINDAHKAN')
        );

      allow update: if pinjamSah() && pinjamIntiTetap()
        && request.resource.data.items.size() == resource.data.items.size()
        && (
          // Pengawas "mengetahui" atau menolak.
          (pengawasAset()
            && resource.data.status == 'DIAJUKAN'
            && request.resource.data.status in ['DIKETAHUI','DITOLAK'])
          ||
          // Gudang menyetujui / menolak setelah diketahui, menyerahkan dengan
          // kondisi keluar, dan menerima kembali dengan kondisi masuk.
          (pengelolaGudang()
            && (
              (resource.data.status == 'DIKETAHUI' && request.resource.data.status in ['DISETUJUI','DITOLAK'])
              || (resource.data.status == 'DISETUJUI' && request.resource.data.status == 'KELUAR'
                  && request.resource.data.kondisiKeluar is map
                  && request.resource.data.kondisiKeluar.skorFisik is number
                  && request.resource.data.kondisiKeluar.skorFisik >= 1
                  && request.resource.data.kondisiKeluar.skorPerforma is number
                  && request.resource.data.kondisiKeluar.skorPerforma >= 1)
              || (resource.data.status == 'BERJALAN' && request.resource.data.status in ['BERJALAN','DIKEMBALIKAN']
                  && request.resource.data.get('kondisiKeluar', null) == resource.data.get('kondisiKeluar', null)
                  && (request.resource.data.status == 'BERJALAN'
                      || (request.resource.data.kondisiMasuk is map
                          && request.resource.data.kondisiMasuk.skorFisik is number
                          && request.resource.data.kondisiMasuk.skorFisik >= 1
                          && request.resource.data.kondisiMasuk.skorPerforma is number
                          && request.resource.data.kondisiMasuk.skorPerforma >= 1)))
            ))
          ||
          // Pengaju / pengawas proyek: konfirmasi terima (KELUAR → BERJALAN),
          // membatalkan sebelum alat keluar, atau memindahkan ke proyek lain.
          ((resource.data.diajukanOleh == emailUser() || resource.data.get('pengawasEmail', '') == emailUser() || pengelolaGudang())
            && (
              (resource.data.status == 'KELUAR' && request.resource.data.status == 'BERJALAN'
                && request.resource.data.get('kondisiKeluar', null) == resource.data.get('kondisiKeluar', null))
              || (resource.data.status in ['DIAJUKAN','DIKETAHUI','DISETUJUI'] && request.resource.data.status == 'DIBATALKAN')
              || (resource.data.status == 'BERJALAN' && request.resource.data.status == 'DIPINDAHKAN'
                  && request.resource.data.pindahKeId is string
                  && request.resource.data.pindahKeId.size() > 0
                  && pinjamanSesudah(request.resource.data.pindahKeId).status == 'BERJALAN')
            ))
        );

      allow delete: if false;
    }

    // ---------- koleksi lain masih ditutup ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

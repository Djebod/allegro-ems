# Salin berkas ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK PERNAH masuk GitHub - itu disengaja.
#
# Sesudah mengisi atau mengubah berkas ini, hentikan npm run dev
# (Ctrl + C) lalu jalankan lagi. Next.js hanya membaca berkas ini
# saat pertama dijalankan.

# --- Firebase (Project settings -> Your apps -> Web) ---
NEXT_PUBLIC_FB_API_KEY=
NEXT_PUBLIC_FB_AUTH_DOMAIN=
NEXT_PUBLIC_FB_PROJECT_ID=
NEXT_PUBLIC_FB_STORAGE_BUCKET=
NEXT_PUBLIC_FB_SENDER_ID=
NEXT_PUBLIC_FB_APP_ID=

# --- Super admin ---
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=syam.rakhmany@gmail.com

# --- Cloudinary (penyimpanan foto) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=allegro_absensi
